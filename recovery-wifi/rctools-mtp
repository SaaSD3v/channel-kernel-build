#!/sbin/sh
PATH=/sbin:/system/bin:/vendor/bin
export PATH

BB=/sbin/busybox.ds
MTPD=/sbin/rctools-mtpd
STATE=/tmp/rctools-mtp
CONFIG=$STATE/config
PIDFILE=$STATE/launcher.pid
CHILDPID=$STATE/server.pid
PREV_USB=$STATE/previous-usb
LOG=$STATE/mtp.log

say(){ printf '%s\n' "$*"; }
err(){ printf 'rctools mtp: %s\n' "$*" >&2; }
clear_screen(){ printf '\033[2J\033[H'; }
pause_screen(){ printf '\nPress Enter to continue...'; IFS= read -r _mtp_pause || true; }

init(){
  "$BB" mkdir -p "$STATE"
  "$BB" chmod 0700 "$STATE" 2>/dev/null || true
  if [ ! -s "$CONFIG" ]; then
    cat >"$CONFIG" <<'EOF'
path=/
name=Channel Root
mode=mtp,adb
EOF
    "$BB" chmod 0600 "$CONFIG" 2>/dev/null || true
  fi
}

cfg(){
  key="$1"
  "$BB" sed -n "s/^$key=//p" "$CONFIG" 2>/dev/null | "$BB" awk 'NR==1{print;exit}'
}

running(){
  [ -s "$PIDFILE" ] || return 1
  pid=$(cat "$PIDFILE" 2>/dev/null || true)
  case "$pid" in ''|*[!0-9]*) return 1;; esac
  kill -0 "$pid" 2>/dev/null
}

server_running(){
  [ -s "$CHILDPID" ] || return 1
  pid=$(cat "$CHILDPID" 2>/dev/null || true)
  case "$pid" in ''|*[!0-9]*) return 1;; esac
  kill -0 "$pid" 2>/dev/null
}

usb_get(){
  getprop "$1" 2>/dev/null || true
}

usb_set(){
  setprop "$1" "$2"
}

wait_prop(){
  key="$1"; want="$2"; loops="${3:-30}"
  i=0
  while [ "$i" -lt "$loops" ]; do
    [ "$(usb_get "$key")" = "$want" ] && return 0
    "$BB" sleep 0.1
    i=$((i+1))
  done
  return 1
}

show_config(){
  say "path : $(cfg path)"
  say "name : $(cfg name)"
  say "mode : $(cfg mode)"
}

write_config(){
  path="$1"; name="$2"; mode="$3"
  tmp="$STATE/config.$$"
  {
    printf 'path=%s\n' "$path"
    printf 'name=%s\n' "$name"
    printf 'mode=%s\n' "$mode"
  } >"$tmp" || return 1
  "$BB" chmod 0600 "$tmp" 2>/dev/null || true
  "$BB" mv "$tmp" "$CONFIG"
}

config_cmd(){
  running && { err "stop MTP before changing configuration"; return 1; }
  sub="${1:-show}"
  [ "$#" -gt 0 ] && shift || true

  path="$(cfg path)"
  name="$(cfg name)"
  mode="$(cfg mode)"

  case "$sub" in
    show) show_config ;;
    path)
      [ "$#" -ge 1 ] || { err "usage: rctools mtp config path PATH"; return 2; }
      [ -d "$1" ] || { err "directory does not exist: $1"; return 1; }
      case "$1" in /*) ;; *) err "path must be absolute"; return 2;; esac
      write_config "$1" "$name" "$mode" || return 1
      say "MTP path: $1"
      ;;
    name)
      [ "$#" -ge 1 ] || { err "usage: rctools mtp config name DISPLAY_NAME"; return 2; }
      [ -n "$*" ] || { err "display name cannot be empty"; return 2; }
      write_config "$path" "$*" "$mode" || return 1
      say "MTP name: $*"
      ;;
    mode)
      [ "$#" -eq 1 ] || { err "usage: rctools mtp config mode {mtp|mtp,adb}"; return 2; }
      case "$1" in mtp|mtp,adb) ;; *) err "mode must be mtp or mtp,adb"; return 2;; esac
      write_config "$path" "$name" "$1" || return 1
      say "USB mode: $1"
      ;;
    reset)
      write_config "/" "Channel Root" "mtp,adb" || return 1
      say "MTP configuration reset"
      show_config
      ;;
    *) err "usage: rctools mtp config [show|path PATH|name NAME|mode mtp|mtp,adb|reset]"; return 2;;
  esac
}

status_cmd(){
  init
  if running && server_running; then state=running
  elif running; then state="launcher running / server missing"
  else state=stopped
  fi
  say "MTP     : $state"
  show_config
  say "usb cfg : $(usb_get sys.usb.config)"
  say "usb state: $(usb_get sys.usb.state)"
  say "mtp ready: $(usb_get sys.usb.ffs.mtp.ready)"
  [ -e /dev/mtp_usb ] && say "device  : /dev/mtp_usb"
  [ -e /dev/usb-ffs/mtp/ep0 ] && say "device  : /dev/usb-ffs/mtp/ep0"
  if [ -s "$PIDFILE" ]; then say "launcher: $(cat "$PIDFILE" 2>/dev/null)"; fi
  if [ -s "$CHILDPID" ]; then say "server  : $(cat "$CHILDPID" 2>/dev/null)"; fi
}

restore_usb(){
  prev=adb
  [ -s "$PREV_USB" ] && prev=$(cat "$PREV_USB" 2>/dev/null || true)
  case "$prev" in
    ''|none|mtp|mtp,adb) prev=adb ;;
  esac
  usb_set sys.usb.ffs.mtp.ready 0
  usb_set sys.usb.config none
  wait_prop sys.usb.state none 15 >/dev/null 2>&1 || true
  usb_set sys.usb.config "$prev"
  "$BB" rm -f "$PREV_USB"
}

start_cmd(){
  init
  [ -x "$MTPD" ] || { err "missing launcher: $MTPD"; return 1; }
  [ -f /system/lib64/libtwrpmtp-ffs.so ] || {
    err "missing TWRP MTP library: /system/lib64/libtwrpmtp-ffs.so"
    return 1
  }

  path=$(cfg path)
  name=$(cfg name)
  mode=$(cfg mode)

  [ -d "$path" ] || { err "configured path does not exist: $path"; return 1; }
  case "$mode" in mtp|mtp,adb) ;; *) err "bad configured USB mode: $mode"; return 1;; esac

  if running && server_running; then
    say "MTP already running"
    status_cmd
    return 0
  fi

  "$BB" rm -f "$PIDFILE" "$CHILDPID"
  : >"$LOG"

  prev=$(usb_get sys.usb.config)
  [ -n "$prev" ] || prev=adb
  printf '%s\n' "$prev" >"$PREV_USB"

  usb_set sys.usb.ffs.mtp.ready 0
  usb_set sys.usb.config none
  wait_prop sys.usb.state none 20 >/dev/null 2>&1 || true

  # The official Channel TWRP init.recovery.usb.rc owns ConfigFS gadget
  # composition. Use its existing mtp / mtp,adb property triggers.
  usb_set sys.usb.config "$mode"
  "$BB" sleep 0.2

  LD_LIBRARY_PATH=/system/lib64:/vendor/lib64 "$MTPD" "$path" "$name" "$CHILDPID" >>"$LOG" 2>&1 &
  launcher=$!
  printf '%s\n' "$launcher" >"$PIDFILE"

  i=0
  while [ "$i" -lt 50 ]; do
    server_running && break
    kill -0 "$launcher" 2>/dev/null || break
    "$BB" sleep 0.1
    i=$((i+1))
  done

  if ! running || ! server_running; then
    err "MTP server failed to start"
    [ -f "$LOG" ] && "$BB" tail -n 40 "$LOG" >&2
    restore_usb
    "$BB" rm -f "$PIDFILE" "$CHILDPID"
    return 1
  fi

  say "MTP started"
  status_cmd
  echo
  say "Connect/reconnect the USB cable."
  say "Windows should show '$name' in This PC."
}

stop_cmd(){
  init
  if [ -s "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    case "$pid" in
      ''|*[!0-9]*) ;;
      *)
        kill "$pid" 2>/dev/null || true
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do
          "$BB" sleep 0.1
          i=$((i+1))
        done
        kill -9 "$pid" 2>/dev/null || true
        ;;
    esac
  fi

  if [ -s "$CHILDPID" ]; then
    pid=$(cat "$CHILDPID" 2>/dev/null || true)
    case "$pid" in ''|*[!0-9]*) ;; *) kill -9 "$pid" 2>/dev/null || true;; esac
  fi

  "$BB" rm -f "$PIDFILE" "$CHILDPID"
  restore_usb
  say "MTP stopped"
}

config_menu(){
  while :; do
    clear_screen
    say "========================================"
    say "          RCTools - MTP Config"
    say "========================================"
    show_config
    echo
    say " [1] Path (default /)"
    say " [2] Windows display name"
    say " [3] USB mode: MTP + ADB"
    say " [4] USB mode: MTP only"
    say " [5] Reset defaults"
    say " [0] Back"
    echo
    printf 'Select: '
    IFS= read -r c || return 0
    case "$c" in
      1)
        printf 'Path: '
        IFS= read -r p
        config_cmd path "$p"
        pause_screen
        ;;
      2)
        printf 'Display name: '
        IFS= read -r n
        config_cmd name "$n"
        pause_screen
        ;;
      3) config_cmd mode mtp,adb; pause_screen ;;
      4)
        say "MTP-only disconnects USB ADB while active."
        printf 'Enable MTP-only? [y/N]: '
        IFS= read -r yn
        case "$yn" in y|Y|yes|YES) config_cmd mode mtp;; *) say "unchanged";; esac
        pause_screen
        ;;
      5) config_cmd reset; pause_screen ;;
      0) return 0 ;;
      *) err "invalid selection"; pause_screen ;;
    esac
  done
}

menu(){
  init
  while :; do
    clear_screen
    running && server_running && run=running || run=stopped
    say "========================================"
    say "              RCTools - MTP"
    say "========================================"
    say " Status : $run"
    say " Path   : $(cfg path)"
    say " Name   : $(cfg name)"
    say " USB    : $(cfg mode)"
    echo
    say " [1] Start MTP"
    say " [2] Stop MTP"
    say " [3] Configure"
    say " [4] Status / diagnostics"
    say " [0] Back"
    echo
    printf 'Select: '
    IFS= read -r c || return 0
    case "$c" in
      1) clear_screen; start_cmd; pause_screen ;;
      2) clear_screen; stop_cmd; pause_screen ;;
      3) config_menu ;;
      4) clear_screen; status_cmd; [ -f "$LOG" ] && { echo; say "--- MTP log ---"; "$BB" tail -n 30 "$LOG"; }; pause_screen ;;
      0) clear_screen; return 0 ;;
      *) err "invalid selection"; pause_screen ;;
    esac
  done
}

help_cmd(){
  cat <<'EOF'
RCTools MTP

  rctools mtp
  rctools mtp start
  rctools mtp stop
  rctools mtp status

Configuration:
  rctools mtp config
  rctools mtp config path /
  rctools mtp config name "Channel Root"
  rctools mtp config mode mtp,adb
  rctools mtp config mode mtp
  rctools mtp config reset

Default:
  path = /
  name = Channel Root
  USB  = mtp,adb
EOF
}

init
cmd="${1:-menu}"
[ "$#" -gt 0 ] && shift || true
case "$cmd" in
  menu) menu ;;
  start) start_cmd ;;
  stop) stop_cmd ;;
  restart) stop_cmd; start_cmd ;;
  status|info) status_cmd ;;
  config) config_cmd "$@" ;;
  help|-h|--help) help_cmd ;;
  *) err "unknown MTP command: $cmd"; help_cmd; exit 2 ;;
esac
