    ui_title 'RCTools GPU - Apply Backend'
    say "  Container : $(container_name "$cfg")"
    say "  Backend   : $backend"
    say '------------------------------------------------------------'

    save_backend "$cfg" "$backend" || {
        ui_pause
        return 1
    }

    if apply_backend "$cfg" "$backend"; then
        say ''
        say 'Configuration applied.'
        say 'Restart a running container so DroidSpaces reloads config and env.'
        say ''
        show_recovery_start_hint "$cfg"
    else
        say ''
        err "backend saved but setup is incomplete"
        err "use 'rctools gpu tools' -> Setup/Status/Test"
    fi

    ui_pause
}

tools_action() {
    action="$1"
    choose_container || return $?

    cfg="$SELECTED_CFG"
    backend="$(saved_backend "$cfg")"

    ui_title "RCTools GPU Tools - $action"
    say "  Container : $(container_name "$cfg")"
    if [ -n "$backend" ]; then
        say "  Backend   : $backend"
    else
        say '  Backend   : none'
    fi
    say '------------------------------------------------------------'

    case "$action" in
        Setup)
            [ -n "$backend" ] || {
                err "select a backend from 'rctools gpu' first"
                ui_pause
                return 1
            }
            apply_backend "$cfg" "$backend"
            ;;
        Status)
            container_status "$cfg"
            ;;
        Enable)
            [ -n "$backend" ] || {
                err "no saved backend"
                ui_pause
                return 1
            }
            apply_backend "$cfg" "$backend"
            ;;
        Disable)
            disable_profile "$cfg"
            ;;
        Test)
            test_profile "$cfg"
            ;;
    esac

    ui_pause
}

gpu_tools_menu() {
    while true; do
        ui_title 'RCTools GPU Tools'
        ui_gpu_summary
        say '  [1] Setup'
        say '      Prepare the selected backend for a container'
        say ''
        say '  [2] Status'
        say '      Show saved backend and DroidSpaces configuration'
        say ''
        say '  [3] Enable'
        say '      Re-enable the saved backend'
        say ''
        say '  [4] Disable'
        say '      Disable GPU profile without forgetting backend'
        say ''
        say '  [5] Test'
        say '      Validate config, devices and real renderer'
        say ''
        say '  [0] Back'
        say '------------------------------------------------------------'
        printf 'Select > '
        IFS= read -r pick || return 1

        case "$pick" in
            1) tools_action Setup ;;
            2) tools_action Status ;;
            3) tools_action Enable ;;
            4) tools_action Disable ;;
            5) tools_action Test ;;
            0) return 0 ;;
            *)
                err "invalid selection"
                ui_pause
                ;;
        esac
    done
}

gpu_main_menu() {
    while true; do
        ui_title 'RCTools GPU'
        ui_gpu_summary
        say '  [1] llvmpipe'
        say '      Software renderer - no direct GPU access'
        say ''
        say '  [2] Freedreno / KGSL'
        say '      Direct Adreno access through /dev/kgsl-3d0'
        say ''
        say '  [3] VirGL'
        say '      virpipe + vtest renderer managed by RCTools'
        say ''
        say '  [4] Tools'
        say '      Setup, status, enable, disable and diagnostics'
        say ''
        say '  [0] Exit'
        say '------------------------------------------------------------'
        printf 'Select > '
        IFS= read -r pick || return 1

        case "$pick" in
            1) backend_action llvmpipe ;;
            2) backend_action freedreno ;;
            3) backend_action virgl ;;
            4) gpu_tools_menu ;;
            0)
                ui_clear
                return 0
                ;;
            *)
                err "invalid selection"
                ui_pause
                ;;
        esac
    done
}

help_gpu() {
    printf '%s\n' \
        'RCTools GPU - headless Qualcomm Adreno backend' \
        '' \
        '  rctools gpu             # interactive llvmpipe/Freedreno/VirGL container menu' \
        '  rctools gpu tools       # setup/status/enable/disable/test container GPU menu' \
        '  rctools gpu status      # KGSL/ION/model/clocks plus VirGL service state' \
        '  rctools gpu start [SOCKET] # prepare GPU + start multi-client VirGL server' \
        '  rctools gpu stop        # stop only the VirGL server and remove its socket' \
        '  rctools gpu prepare     # mount vendor, stage firmware and graphics HAL' \
        '  rctools gpu load        # prove libgsl + embedded libsync can link' \
        '  rctools gpu gralloc     # hw_get_module(gralloc) discovery test' \
        '  rctools gpu probe       # EGL pbuffer + GLES2 render/readback test' \
        '  rctools gpu opencl      # real OpenCL vector-add GPU test' \
        '  rctools gpu libs        # show Qualcomm userspace components' \
        '  rctools gpu firmware    # show Adreno firmware/path state' \
        '  rctools gpu logs        # recent KGSL/Adreno/IOMMU diagnostics'
}

[ -x "$BB" ] || { err "missing BusyBox backend: $BB"; exit 1; }

cmd="${1:-menu}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
    menu) gpu_main_menu ;;
    tools) gpu_tools_menu ;;
    status) show_status ;;
    start) start_virgl "$@" ;;
    stop) stop_virgl ;;
    prepare)
        prepare_gpu && {
            say 'GPU headless runtime ready'
            say "LD_LIBRARY_PATH=$GPU_LIBPATH"
        }
        ;;
    load|linker) load_test ;;
    probe|test) run_probe ;;
    gralloc|hal) run_gralloc_probe ;;
    opencl|compute) run_opencl_probe ;;
    libs) show_libs ;;
    firmware|fw) show_firmware ;;
    logs|log) show_logs ;;
    help|h|-h|--help) help_gpu ;;
    *)
        err "unknown GPU command: $cmd"
        echo
        help_gpu
        exit 2
        ;;
esac
