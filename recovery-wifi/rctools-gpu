#!/sbin/sh
# RCTools GPU - headless Adreno/KGSL backend for Motorola Channel.

PATH=/sbin:/system/bin:/vendor/bin
TMPDIR=/tmp
TMP=/tmp
TEMP=/tmp
export PATH TMPDIR TMP TEMP

BB=/sbin/busybox.ds
RCTOOLS=/sbin/rctools
GPU_PROBE=/sbin/rctools-gpu-probe.so
OPENCL_PROBE=/sbin/rctools-opencl-probe.so
GRALLOC_PROBE=/sbin/rctools-gralloc-probe.so
LIBSYNC=/sbin/libsync.so
VENDOR=/mnt/vendor
KGSL=/sys/class/kgsl/kgsl-3d0
GPU_LIBPATH=/sbin:/system/lib64:/mnt/vendor/lib64:/mnt/vendor/lib64/egl:/mnt/vendor/lib64/hw
VIRGL_ROOT=/sbin/virgl
VIRGL_SERVER=$VIRGL_ROOT/virgl_test_server
VIRGL_LIBDIR=$VIRGL_ROOT/lib
VIRGL_SHIM=$VIRGL_LIBDIR/librctools-memfd-compat.so
VIRGL_PIDFILE=/tmp/rctools-virgl.pid
VIRGL_STATE=/tmp/rctools-virgl.socket
VIRGL_LOG=/tmp/rctools-virgl.log
VIRGL_RENDER_LOG=/tmp/rctools-virgl-renderer.log
VIRGL_DEFAULT_SOCKET=/data/local/Droidspaces/virgl/.virgl_test

say() { printf '%s\n' "$*"; }
err() { printf 'rctools gpu: %s\n' "$*" >&2; }

mounted_vendor() {
    "$BB" awk '$2 == "/mnt/vendor" { found=1 } END { exit found ? 0 : 1 }' /proc/mounts 2>/dev/null
}

ensure_vendor() {
    if mounted_vendor; then
        return 0
    fi

    "$RCTOOLS" mount active vendor ro >/dev/null || {
        err "could not mount active vendor read-only"
        return 1
    }
}

required_file() {
    [ -r "$1" ] || {
        err "missing required file: $1"
        return 1
    }
}

stage_gpu_firmware() {
    "$BB" mkdir -p /lib/firmware 2>/dev/null || return 1

    for name in a530_pm4.fw a530_pfp.fw; do
        src="$VENDOR/firmware/$name"
        dst="/lib/firmware/$name"
        required_file "$src" || return 1

        if [ ! -s "$dst" ]; then
            "$BB" cat "$src" > "$dst" 2>/dev/null || {
                err "could not stage GPU firmware: $name"
                return 1
            }
        fi
    done

    if [ ! -s /lib/firmware/a506_zap.mdt ]; then
        if ! "$RCTOOLS" mount modem active ro >/dev/null 2>&1; then
            err "could not mount active modem partition for a506_zap firmware"
            return 1
        fi

        zapdir=
        for dir in /mnt/modem/image /mnt/modem; do
            if [ -s "$dir/a506_zap.mdt" ]; then
                zapdir="$dir"
                break
            fi
        done

        [ -n "$zapdir" ] || {
            err "a506_zap.mdt not found in active modem partition"
            return 1
        }

        found=0
        for src in "$zapdir"/a506_zap.*; do
            [ -f "$src" ] || continue
            name=${src##*/}
            "$BB" cat "$src" > "/lib/firmware/$name" 2>/dev/null || {
                err "could not stage GPU ZAP firmware: $name"
                return 1
            }
            found=1
        done

        [ "$found" -eq 1 ] || {
            err "no a506_zap firmware segments were staged"
            return 1
        }
    fi

    required_file /lib/firmware/a506_zap.mdt || return 1

    pathnode=/sys/module/firmware_class/parameters/path
    if [ -w "$pathnode" ]; then
        current="$(cat "$pathnode" 2>/dev/null)"
        case "$current" in
            ""|/lib/firmware)
                echo /lib/firmware > "$pathnode" 2>/dev/null || true
                ;;
            *)
                err "firmware_class.path is already set to: $current"
                err "not overriding an unrelated firmware owner"
                return 1
                ;;
        esac
    fi

    return 0
}
stage_graphics_hal() {
    "$BB" mkdir -p /vendor/lib64/hw 2>/dev/null || return 1

    # libhardware's hw_module_exists() canonicalizes HAL paths with realpath()
    # and rejects modules whose resolved path escapes /vendor/lib64/hw.
    # Therefore these must be real files, not symlinks into /mnt/vendor.
    for name in gralloc.msm8953.so gralloc.default.so; do
        src="$VENDOR/lib64/hw/$name"
        dst="/vendor/lib64/hw/$name"
        [ -r "$src" ] || continue

        "$BB" rm -f "$dst" 2>/dev/null || true
        "$BB" cat "$src" > "$dst" 2>/dev/null || {
            err "could not copy graphics HAL into recovery vendor: $name"
            return 1
        }
        "$BB" chmod 0644 "$dst" 2>/dev/null || true
    done

    [ -r /vendor/lib64/hw/gralloc.msm8953.so ] || {
        err "gralloc.msm8953.so was not copied under /vendor/lib64/hw"
        return 1
    }

    return 0
}

prepare_gpu() {
    [ "$(id -u 2>/dev/null)" = "0" ] || {
        err "run from a root recovery shell"
        return 1
    }

    [ -c /dev/kgsl-3d0 ] || {
        err "/dev/kgsl-3d0 is missing"
        return 1
    }
    [ -c /dev/ion ] || {
        err "/dev/ion is missing"
        return 1
    }

    required_file "$LIBSYNC" || return 1
    required_file "$GPU_PROBE" || return 1
    required_file "$OPENCL_PROBE" || return 1
    required_file "$GRALLOC_PROBE" || return 1
    required_file /system/bin/linker64 || return 1
    required_file /system/bin/sh || return 1

    ensure_vendor || return 1

    for f in         "$VENDOR/lib64/libgsl.so"         "$VENDOR/lib64/libadreno_utils.so"         "$VENDOR/lib64/libllvm-glnext.so"         "$VENDOR/lib64/egl/libEGL_adreno.so"         "$VENDOR/lib64/egl/libGLESv2_adreno.so"         "$VENDOR/lib64/egl/eglSubDriverAndroid.so"         "$VENDOR/firmware/a530_pm4.fw"         "$VENDOR/firmware/a530_pfp.fw"
    do
        required_file "$f" || return 1
    done

    stage_gpu_firmware || return 1
    stage_graphics_hal || return 1
    return 0
}


virgl_saved_socket() {
    [ -r "$VIRGL_STATE" ] && "$BB" cat "$VIRGL_STATE" 2>/dev/null
}

virgl_find_pid() {
    if [ -r "$VIRGL_PIDFILE" ]; then
        p="$("$BB" cat "$VIRGL_PIDFILE" 2>/dev/null)"
        case "$p" in
            ''|*[!0-9]*) ;;
            *)
                exe="$("$BB" readlink "/proc/$p/exe" 2>/dev/null)"
                if [ "$exe" = "$VIRGL_SERVER" ]; then
                    printf '%s\n' "$p"
                    return 0
                fi
                ;;
        esac
    fi

    for pdir in /proc/[0-9]*; do
        [ -d "$pdir" ] || continue
        exe="$("$BB" readlink "$pdir/exe" 2>/dev/null)"
        [ "$exe" = "$VIRGL_SERVER" ] || continue
        printf '%s\n' "${pdir##*/}"
        return 0
    done
    return 1
}

virgl_runtime_ready() {
    [ -x "$VIRGL_SERVER" ] || {
        err "missing VirGL server: $VIRGL_SERVER"
        return 1
    }
    required_file "$VIRGL_SHIM" || return 1
    required_file "$VIRGL_LIBDIR/libvirglrenderer.so.1" || return 1
    required_file "$VIRGL_LIBDIR/libepoxy.so.0" || return 1
    required_file "$VIRGL_LIBDIR/libEGL.so.1" || return 1
    required_file "$VIRGL_LIBDIR/libGLESv2.so.2" || return 1
    return 0
}

show_virgl_status() {
    say '--- VirGL service ---'
    [ -x "$VIRGL_SERVER" ] && say 'runtime: embedded' || say 'runtime: missing'

    pid="$(virgl_find_pid 2>/dev/null)"
    sock="$(virgl_saved_socket)"

    if [ -n "$pid" ]; then
        say "virgl: running"
        say "pid=$pid"
    else
        say "virgl: stopped"
    fi

    if [ -n "$sock" ]; then
        say "socket=$sock"
        [ -S "$sock" ] && say 'socket_state=ready' || say 'socket_state=missing'
    else
        say "socket: none"
    fi
}

start_virgl() {
    prepare_gpu || return 1
    virgl_runtime_ready || return 1

    sock="${1:-${VIRGL_SOCKET:-$VIRGL_DEFAULT_SOCKET}}"
    case "$sock" in
        /*) ;;
        *)
            err "VirGL socket path must be absolute: $sock"
            return 2
            ;;
    esac

    pid="$(virgl_find_pid 2>/dev/null)"
    if [ -n "$pid" ]; then
        oldsock="$(virgl_saved_socket)"
        if [ "$oldsock" = "$sock" ] && [ -S "$sock" ]; then
            say "VirGL already running"
            say "pid=$pid"
            say "socket=$sock"
            return 0
        fi
        err "VirGL is already running (pid=$pid)"
        [ -n "$oldsock" ] && err "current socket: $oldsock"
        err "run 'rctools gpu stop' before changing the socket"
        return 1
    fi

    "$BB" rm -f "$VIRGL_PIDFILE" "$VIRGL_STATE" 2>/dev/null || true

    parent="${sock%/*}"
    [ -n "$parent" ] || parent=/
    "$BB" mkdir -p "$parent" 2>/dev/null || {
        err "could not create VirGL socket directory: $parent"
        return 1
    }

    if [ -e "$sock" ] || [ -S "$sock" ]; then
        if [ -S "$sock" ]; then
            "$BB" rm -f "$sock" || return 1
        else
            err "refusing to replace non-socket path: $sock"
            return 1
        fi
    fi

    "$BB" rm -f "$VIRGL_LOG" "$VIRGL_RENDER_LOG" 2>/dev/null || true
    virgl_libpath="$VIRGL_LIBDIR:$GPU_LIBPATH"

    VIRGL_DISABLE_MT=1 \
    VIRGL_LOG_LEVEL=debug \
    VIRGL_LOG_FILE="$VIRGL_RENDER_LOG" \
    LD_LIBRARY_PATH="$virgl_libpath" \
    LD_PRELOAD="$VIRGL_SHIM" \
    "$VIRGL_SERVER" \
        --no-fork \
        --multi-clients \
        --use-egl-surfaceless \
        --use-gles \
        --socket-path="$sock" \
        >"$VIRGL_LOG" 2>&1 &

    pid=$!
    printf '%s\n' "$pid" > "$VIRGL_PIDFILE"
    printf '%s\n' "$sock" > "$VIRGL_STATE"

    i=0
    while [ "$i" -lt 5 ]; do
        if kill -0 "$pid" 2>/dev/null && [ -S "$sock" ]; then
            say 'VirGL started'
            say "pid=$pid"
            say "socket=$sock"
            say 'mode=multi-client EGL-surfaceless GLES'
            return 0
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            break
        fi
        sleep 1
        i=$((i + 1))
    done

    err "VirGL server failed to become ready"
    [ -s "$VIRGL_LOG" ] && "$BB" tail -n 80 "$VIRGL_LOG" >&2
    kill "$pid" 2>/dev/null || true
    [ -S "$sock" ] && "$BB" rm -f "$sock" 2>/dev/null || true
    "$BB" rm -f "$VIRGL_PIDFILE" "$VIRGL_STATE" 2>/dev/null || true
    return 1
}

stop_virgl() {
    pid="$(virgl_find_pid 2>/dev/null)"
    sock="$(virgl_saved_socket)"

    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 5 ]; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    if [ -n "$sock" ] && [ -S "$sock" ]; then
        "$BB" rm -f "$sock" 2>/dev/null || true
    fi
    "$BB" rm -f "$VIRGL_PIDFILE" "$VIRGL_STATE" 2>/dev/null || true

    if [ -n "$pid" ]; then
        say "VirGL stopped (pid=$pid)"
    else
        say 'VirGL already stopped'
    fi
}

show_status() {
    say '--- Channel headless GPU ---'
    if [ -c /dev/kgsl-3d0 ]; then
        "$BB" ls -l /dev/kgsl-3d0 2>/dev/null
    else
        say '/dev/kgsl-3d0: missing'
    fi
    if [ -c /dev/ion ]; then
        "$BB" ls -l /dev/ion 2>/dev/null
    else
        say '/dev/ion: missing'
    fi

    if [ -d "$KGSL" ]; then
        for f in gpu_model gpuclk max_gpuclk max_pwrlevel min_pwrlevel default_pwrlevel num_pwrlevels gpubusy; do
            [ -r "$KGSL/$f" ] && printf '%s=%s\n' "$f" "$(cat "$KGSL/$f" 2>/dev/null)"
        done

        df="$KGSL/devfreq"
        if [ -d "$df" ]; then
            for f in governor cur_freq min_freq max_freq available_frequencies; do
                [ -r "$df/$f" ] && printf 'devfreq_%s=%s\n' "$f" "$(cat "$df/$f" 2>/dev/null)"
            done
        fi
    else
        say 'KGSL sysfs: missing'
    fi

    if mounted_vendor; then
        say 'vendor: mounted at /mnt/vendor'
    else
        say 'vendor: not mounted'
    fi

    [ -r "$LIBSYNC" ] && say 'libsync: embedded' || say 'libsync: missing'
    [ -r "$GPU_PROBE" ] && say 'egl probe: embedded' || say 'egl probe: missing'
    [ -r "$OPENCL_PROBE" ] && say 'opencl probe: embedded' || say 'opencl probe: missing'
    [ -r "$GRALLOC_PROBE" ] && say 'gralloc probe: embedded' || say 'gralloc probe: missing'
    show_virgl_status
}

show_libs() {
    ensure_vendor || return 1
    for f in         "$VENDOR/lib64/libgsl.so"         "$VENDOR/lib64/libadreno_utils.so"         "$VENDOR/lib64/libllvm-glnext.so"         "$VENDOR/lib64/libOpenCL.so"         "$VENDOR/lib64/libC2D2.so"         "$VENDOR/lib64/hw/vulkan.msm8953.so"         "$VENDOR/lib64/egl/libEGL_adreno.so"         "$VENDOR/lib64/egl/libGLESv2_adreno.so"         "$VENDOR/lib64/egl/eglSubDriverAndroid.so"
    do
        if [ -r "$f" ]; then
            "$BB" ls -l "$f"
        else
            say "missing: $f"
        fi
    done
}

show_firmware() {
    ensure_vendor || return 1
    say "firmware_class.path=$(cat /sys/module/firmware_class/parameters/path 2>/dev/null)"
    for f in a530_pm4.fw a530_pfp.fw; do
        if [ -r "$VENDOR/firmware/$f" ]; then
            "$BB" ls -l "$VENDOR/firmware/$f"
        else
            say "missing: $VENDOR/firmware/$f"
        fi
    done
    for f in /lib/firmware/a506_zap.*; do
        [ -f "$f" ] && "$BB" ls -l "$f"
    done
}
load_test() {
    prepare_gpu || return 1
    say 'stage=linker loading libgsl'
    LD_LIBRARY_PATH="$GPU_LIBPATH"     LD_PRELOAD="$VENDOR/lib64/libgsl.so"         /system/bin/sh -c ':'
    rc=$?
    [ "$rc" -eq 0 ] && say 'PASS GPU_LINKER_OK'
    return "$rc"
}

run_probe() {
    prepare_gpu || return 1

    say 'stage=headless EGL/GLES2 probe'
    LD_LIBRARY_PATH="$GPU_LIBPATH"     LD_PRELOAD="$GPU_PROBE"         /system/bin/sh -c ':'
}

run_opencl_probe() {
    prepare_gpu || return 1
    required_file "$VENDOR/lib64/libOpenCL.so" || return 1
    required_file "$VENDOR/lib64/libCB.so" || return 1

    say 'stage=OpenCL compute probe'
    LD_LIBRARY_PATH="$GPU_LIBPATH"     LD_PRELOAD="$OPENCL_PROBE"         /system/bin/sh -c ':'
}

run_gralloc_probe() {
    prepare_gpu || return 1

    say 'stage=gralloc direct linker probe'
    required_file "$VENDOR/lib64/hw/gralloc.msm8953.so" || return 1
    LD_LIBRARY_PATH="$GPU_LIBPATH" \
    LD_PRELOAD="$VENDOR/lib64/hw/gralloc.msm8953.so" \
        /system/bin/sh -c ':'
    rc=$?
    if [ "$rc" -ne 0 ]; then
        err "gralloc.msm8953.so failed direct linker load (rc=$rc)"
        return "$rc"
    fi
    say 'PASS GRALLOC_LINKER_OK'

    say 'stage=gralloc HAL discovery probe'
    say "ro.hardware=$(getprop ro.hardware 2>/dev/null)"
    say "ro.product.board=$(getprop ro.product.board 2>/dev/null)"
    say "ro.board.platform=$(getprop ro.board.platform 2>/dev/null)"
    "$BB" ls -l /vendor/lib64/hw/gralloc*.so 2>/dev/null || true

    LD_LIBRARY_PATH="$GPU_LIBPATH" \
    LD_PRELOAD="$GRALLOC_PROBE" \
        /system/bin/sh -c ':'
}
show_logs() {
    dmesg | "$BB" grep -iE         'kgsl|adreno|a506|a530|gpu|iommu|firmware|zap|egl|gsl|fault|error'         | "$BB" tail -n 250
    if [ -s "$VIRGL_LOG" ]; then
        say '--- VirGL server log ---'
        "$BB" tail -n 120 "$VIRGL_LOG"
    fi
    if [ -s "$VIRGL_RENDER_LOG" ]; then
        say '--- VirGL renderer log ---'
        "$BB" tail -n 120 "$VIRGL_RENDER_LOG"
    fi
}


DS_BIN=/data/local/Droidspaces/bin/droidspaces
DS_DEFAULT_ROOT=/data/local/Droidspaces
GPU_ENV_BEGIN='# RCTOOLS_GPU_BEGIN'
GPU_ENV_END='# RCTOOLS_GPU_END'

ui_clear() {
    printf '\033[2J\033[H'
}

ui_rule() {
    say '============================================================'
}

ui_title() {
    title="$1"
    ui_clear
    ui_rule
    printf '  %s\n' "$title"
    ui_rule
}

ui_gpu_summary() {
    model="$(cat "$KGSL/gpu_model" 2>/dev/null)"
    [ -n "$model" ] || model='unknown'
    if [ -c /dev/kgsl-3d0 ]; then
        node='ready'
    else
        node='missing'
    fi
    printf '  Device : %-16s KGSL: %s\n' "$model" "$node"
    say '------------------------------------------------------------'
}

ui_pause() {
    say ''
    printf 'Press Enter to continue...'
    IFS= read -r _pause
}

cfg_get() {
    file="$1"
    key="$2"
    [ -r "$file" ] || return 1
    "$BB" awk -v k="$key" 'index($0,k"=")==1 {print substr($0,length(k)+2); exit}' "$file"
}

cfg_set() {
    file="$1"
    key="$2"
    value="$3"
    tmp="/tmp/rctools-gpu-cfg.$$"

    [ -f "$file" ] || {
        err "container config not found: $file"
        return 1
    }

    "$BB" awk -v k="$key" -v v="$value" '
      BEGIN {done=0}
      index($0,k"=")==1 {if(!done) print k"="v; done=1; next}
      {print}
      END {if(!done) print k"="v}
    ' "$file" >"$tmp" || return 1

    "$BB" cat "$tmp" >"$file" || {
        "$BB" rm -f "$tmp"
        return 1
    }
    "$BB" rm -f "$tmp"
}

container_name() {
    cfg="$1"
    name="$(cfg_get "$cfg" name 2>/dev/null)"
    if [ -n "$name" ]; then
        printf '%s\n' "$name"
        return
    fi
    dir="$("$BB" dirname "$cfg")"
    "$BB" basename "$dir"
}

container_rootfs() {
    cfg_get "$1" rootfs_path 2>/dev/null
}

state_file() {
    dir="$("$BB" dirname "$1")"
    printf '%s/.rctools-gpu-backend\n' "$dir"
}

saved_backend() {
    f="$(state_file "$1")"
    [ -r "$f" ] && "$BB" cat "$f" 2>/dev/null
}

save_backend() {
    f="$(state_file "$1")"
    printf '%s\n' "$2" >"$f"
}

ensure_env_file() {
    cfg="$1"
    env="$(cfg_get "$cfg" env_file 2>/dev/null)"

    if [ -z "$env" ]; then
        dir="$("$BB" dirname "$cfg")"
        env="$dir/.env"
        cfg_set "$cfg" env_file "$env" || return 1
    fi

    parent="$("$BB" dirname "$env")"
    "$BB" mkdir -p "$parent" 2>/dev/null || return 1
    [ -e "$env" ] || : >"$env"
    printf '%s\n' "$env"
}

sanitize_legacy_gpu_profile() {
    cfg="$1"
    root="$(container_rootfs "$cfg")"

    [ -n "$root" ] && [ -d "$root" ] || return 0

    file="$root/etc/profile.d/virgl.sh"
    [ -e "$file" ] || return 0

    tmp="/tmp/rctools-gpu-profile.$"
    "$BB" awk '
      {
        probe=$0
        sub(/^[[:space:]]*export[[:space:]]+/, "", probe)
      }
      probe ~ /^(GALLIUM_DRIVER|VTEST_SOCKET_NAME|LIBGL_ALWAYS_SOFTWARE)=/ {next}
      {print}
    ' "$file" >"$tmp" || return 1

    if "$BB" grep -q '[^[:space:]]' "$tmp" 2>/dev/null; then
        "$BB" cat "$tmp" >"$file" || {
            "$BB" rm -f "$tmp"
            return 1
        }
    else
        "$BB" rm -f "$file" || {
            "$BB" rm -f "$tmp"
            return 1
        }
    fi

    "$BB" rm -f "$tmp"
    say 'legacy_profile_sanitized=/etc/profile.d/virgl.sh'
    return 0
}

strip_gpu_env() {
    file="$1"
    tmp="/tmp/rctools-gpu-env.clean.$"
    [ -e "$file" ] || : >"$file"

    "$BB" awk '
      $0=="# RCTOOLS_GPU_BEGIN" {skip=1; next}
      $0=="# RCTOOLS_GPU_END" {skip=0; next}
      skip {next}
      {
        probe=$0
        sub(/^[[:space:]]*export[[:space:]]+/, "", probe)
      }
      probe ~ /^(RCTOOLS_GPU_BACKEND|RCTOOLS_GPU_PRESENTATION|RCTOOLS_GPU_VIRTUALGL|GALLIUM_DRIVER|VTEST_SOCKET_NAME|LIBGL_ALWAYS_SOFTWARE|MESA_LOADER_DRIVER_OVERRIDE|LIBGL_DRIVERS_PATH|__EGL_VENDOR_LIBRARY_FILENAMES|VGL_DISPLAY|VGL_FORCEALPHA|VGL_READBACK|LIBGL_DEBUG|MESA_DEBUG)=/ {next}
      {print}
    ' "$file" >"$tmp" || return 1

    "$BB" cat "$tmp" >"$file" || {
        "$BB" rm -f "$tmp"
        return 1
    }
    "$BB" rm -f "$tmp"
}

write_gpu_env() {
    cfg="$1"
    backend="$2"
    shift 2

    env="$(ensure_env_file "$cfg")" || return 1
    strip_gpu_env "$env" || return 1

    {
        echo "$GPU_ENV_BEGIN"
        echo "RCTOOLS_GPU_BACKEND=$backend"
        while [ "$#" -gt 0 ]; do
            echo "$1"
            shift
        done
        echo "$GPU_ENV_END"
    } >>"$env" || return 1

    say "env_file=$env"
}

clear_gpu_env() {
    cfg="$1"
    env="$(cfg_get "$cfg" env_file 2>/dev/null)"
    if [ -n "$env" ] && [ -e "$env" ]; then
        strip_gpu_env "$env"
    fi
    return 0
}

direct_runtime() {
    cfg="$1"
    root="$(container_rootfs "$cfg")"

    [ -n "$root" ] && [ -d "$root" ] || {
        err "Freedreno currently requires a directory rootfs_path"
        return 1
    }

    guest_root=
    host_root=
    for p in /opt/rctools-gpu/mesa/usr /opt/mesa-kgsl-test/usr; do
        if [ -d "$root$p" ]; then
            guest_root="$p"
            host_root="$root$p"
            break
        fi
    done

    [ -n "$host_root" ] || {
        err "Mesa Freedreno/KGSL runtime not found"
        err "expected /opt/rctools-gpu/mesa/usr or /opt/mesa-kgsl-test/usr"
        return 1
    }

    guest_lib=
    for s in lib/aarch64-linux-gnu lib; do
        if [ -e "$host_root/$s/dri/kgsl_dri.so" ]; then
            guest_lib="$guest_root/$s"
            break
        fi
    done

    [ -n "$guest_lib" ] || {
        err "kgsl_dri.so not found"
        return 1
    }

    direct_ld="$guest_lib"
    for p in /opt/rctools-gpu/llvm/usr/lib /opt/llvm22-test/usr/lib; do
        if [ -d "$root$p" ]; then
            direct_ld="$p:$direct_ld"
            break
        fi
    done

    direct_dri="$guest_lib/dri"
    direct_json=
    if [ -r "$host_root/share/glvnd/egl_vendor.d/50_mesa.json" ]; then
        direct_json="$guest_root/share/glvnd/egl_vendor.d/50_mesa.json"
    fi

    # Optional patched VirtualGL runtime.  Only the project-specific
    # /opt/VirtualGL-KGSL prefix is accepted, so a stock VirtualGL install is
    # never silently switched to the non-standard eglkgsl display.
    direct_vgl=0
    if [ -x "$root/opt/VirtualGL-KGSL/bin/vglrun" ] &&
       [ -r "$root/opt/VirtualGL-KGSL/lib/libvglfaker.so" ]; then
        direct_vgl=1
    fi
}

stop_virgl_for_cfg() {
    cfg="$1"
    root="$(container_rootfs "$cfg")"
    current="$(virgl_saved_socket)"
    if [ -n "$root" ] && [ "$current" = "$root/root/.virgl_test" ]; then
        stop_virgl
    fi
    return 0
}

prime_direct_kgsl() {
    prepare_gpu || return 1

    log=/tmp/rctools-kgsl-prime.log
    tries=0

    say 'stage=prime KGSL/ZAP'

    while [ "$tries" -lt 20 ]; do
        tries=$((tries + 1))
        : >"$log"

        if ( exec 9<>/dev/kgsl-3d0; exec 9>&- ) 2>"$log"; then
            say "PASS KGSL_ZAP_READY attempts=$tries"
            "$BB" rm -f "$log"
            return 0
        fi

        if "$BB" grep -qi 'temporarily unavailable' "$log"; then
            "$BB" usleep 100000 2>/dev/null || sleep 1
            continue
        fi

        break
    done

    err "KGSL/ZAP prime failed after $tries attempt(s)"
    [ -s "$log" ] && "$BB" cat "$log" >&2
    err 'recent kernel GPU log:'
    dmesg | "$BB" grep -iE 'kgsl|adreno|a506|zap|pil|subsystem|firmware|Runtime PM' | "$BB" tail -n 80 >&2
    "$BB" rm -f "$log"
    return 1
}

apply_llvmpipe() {
    cfg="$1"
    stop_virgl_for_cfg "$cfg"
    cfg_set "$cfg" enable_hw_access 0 || return 1
    cfg_set "$cfg" enable_gpu_mode 0 || return 1
    cfg_set "$cfg" enable_virgl 0 || return 1
    write_gpu_env "$cfg" llvmpipe \
        'LIBGL_ALWAYS_SOFTWARE=1' \
        'GALLIUM_DRIVER=llvmpipe' || return 1
    say 'backend=llvmpipe'
}

apply_freedreno() {
    cfg="$1"
    direct_runtime "$cfg" || return 1
    stop_virgl_for_cfg "$cfg"
    prime_direct_kgsl || return 1

    cfg_set "$cfg" enable_hw_access 0 || return 1
    cfg_set "$cfg" enable_gpu_mode 1 || return 1
    cfg_set "$cfg" enable_virgl 0 || return 1

    if [ "$direct_vgl" -eq 1 ] && [ -n "$direct_json" ]; then
        write_gpu_env "$cfg" freedreno \
            'RCTOOLS_GPU_PRESENTATION=surfaceless' \
            'RCTOOLS_GPU_VIRTUALGL=1' \
            "LD_LIBRARY_PATH=$direct_ld" \
            "LIBGL_DRIVERS_PATH=$direct_dri" \
            'MESA_LOADER_DRIVER_OVERRIDE=kgsl' \
            "__EGL_VENDOR_LIBRARY_FILENAMES=$direct_json" \
            'VGL_DISPLAY=eglkgsl' \
            'VGL_FORCEALPHA=1' \
            'VGL_READBACK=sync' || return 1
    elif [ "$direct_vgl" -eq 1 ]; then
        write_gpu_env "$cfg" freedreno \
            'RCTOOLS_GPU_PRESENTATION=surfaceless' \
            'RCTOOLS_GPU_VIRTUALGL=1' \
            "LD_LIBRARY_PATH=$direct_ld" \
            "LIBGL_DRIVERS_PATH=$direct_dri" \
            'MESA_LOADER_DRIVER_OVERRIDE=kgsl' \
            'VGL_DISPLAY=eglkgsl' \
            'VGL_FORCEALPHA=1' \
            'VGL_READBACK=sync' || return 1
    elif [ -n "$direct_json" ]; then
        write_gpu_env "$cfg" freedreno \
            'RCTOOLS_GPU_PRESENTATION=surfaceless' \
            'RCTOOLS_GPU_VIRTUALGL=0' \
            "LD_LIBRARY_PATH=$direct_ld" \
            "LIBGL_DRIVERS_PATH=$direct_dri" \
            'MESA_LOADER_DRIVER_OVERRIDE=kgsl' \
            "__EGL_VENDOR_LIBRARY_FILENAMES=$direct_json" || return 1
    else
        write_gpu_env "$cfg" freedreno \
            'RCTOOLS_GPU_PRESENTATION=surfaceless' \
            'RCTOOLS_GPU_VIRTUALGL=0' \
            "LD_LIBRARY_PATH=$direct_ld" \
            "LIBGL_DRIVERS_PATH=$direct_dri" \
            'MESA_LOADER_DRIVER_OVERRIDE=kgsl' || return 1
    fi

    say 'backend=freedreno'
    say 'mode=direct KGSL'
    say 'presentation=EGL surfaceless'
    if [ "$direct_vgl" -eq 1 ]; then
        say 'virtualgl_kgsl=enabled (BGRA alpha, synchronous readback)'
    else
        say 'virtualgl_kgsl=not installed'
    fi
}

apply_virgl() {
    cfg="$1"
    root="$(container_rootfs "$cfg")"

    [ -n "$root" ] && [ -d "$root" ] || {
        err "VirGL currently requires a directory rootfs_path"
        return 1
    }

    socket="$root/root/.virgl_test"
    current="$(virgl_saved_socket)"
    otherpid="$(virgl_find_pid 2>/dev/null)"

    if [ -n "$current" ] && [ "$current" != "$socket" ] && [ -n "$otherpid" ]; then
        err "VirGL is already owned by another container"
        err "socket=$current"
        return 1
    fi

    cfg_set "$cfg" enable_hw_access 0 || return 1
    cfg_set "$cfg" enable_gpu_mode 0 || return 1
    cfg_set "$cfg" enable_virgl 0 || return 1

    write_gpu_env "$cfg" virgl \
        'GALLIUM_DRIVER=virpipe' \
        'VTEST_SOCKET_NAME=/root/.virgl_test' || return 1

    start_virgl "$socket" || return 1
    say 'backend=virgl'
}

apply_backend() {
    cfg="$1"
    backend="$2"

    sanitize_legacy_gpu_profile "$cfg" || {
        err "could not sanitize legacy /etc/profile.d/virgl.sh"
        return 1
    }

    case "$backend" in
        llvmpipe) apply_llvmpipe "$cfg" ;;
        freedreno) apply_freedreno "$cfg" ;;
        virgl) apply_virgl "$cfg" ;;
        *) return 2 ;;
    esac
}

disable_profile() {
    cfg="$1"
    stop_virgl_for_cfg "$cfg"
    cfg_set "$cfg" enable_gpu_mode 0 || return 1
    cfg_set "$cfg" enable_virgl 0 || return 1
    clear_gpu_env "$cfg" || return 1
    say 'GPU profile disabled; saved backend preserved'
}

container_status() {
    cfg="$1"
    name="$(container_name "$cfg")"
    backend="$(saved_backend "$cfg")"

    say "--- GPU container: $name ---"
    say "config=$cfg"
    say "rootfs_path=$(container_rootfs "$cfg")"
    if [ -n "$backend" ]; then
        say "saved_backend=$backend"
    else
        say 'saved_backend=none'
    fi
    say "enable_hw_access=$(cfg_get "$cfg" enable_hw_access)"
    say "enable_gpu_mode=$(cfg_get "$cfg" enable_gpu_mode)"
    say "enable_virgl=$(cfg_get "$cfg" enable_virgl)"
    say "env_file=$(cfg_get "$cfg" env_file)"

    if [ "$backend" = freedreno ]; then
        if direct_runtime "$cfg" >/dev/null 2>&1; then
            say 'freedreno_runtime=ready'
            say "presentation=EGL surfaceless"
            if [ "$direct_vgl" -eq 1 ]; then
                say 'virtualgl_kgsl=ready'
                say 'virtualgl_forcealpha=1'
                say 'virtualgl_readback=sync'
            else
                say 'virtualgl_kgsl=not installed'
            fi
            say 'xserver_env=clean (do not start Xtigervnc with KGSL Mesa variables)'
        else
            say 'freedreno_runtime=missing'
        fi
    fi
}

test_profile() {
    cfg="$1"
    name="$(container_name "$cfg")"
    backend="$(saved_backend "$cfg")"
    pre="/tmp/rctools-gpu-pretest.$"
    log="/tmp/rctools-gpu-test.$"
    env="$(cfg_get "$cfg" env_file 2>/dev/null)"
    [ -n "$env" ] || env="$("$BB" dirname "$cfg")/.env"

    [ -r "$env" ] || {
        err "GPU environment file missing: $env"
        return 1
    }

    [ -x "$DS_BIN" ] || {
        err "DroidSpaces binary missing: $DS_BIN"
        return 1
    }

    "$DS_BIN" --conf="$cfg" --env="$env" run sh -c '
        echo "=== loaded config ==="
        grep -E "^(enable_hw_access|enable_gpu_mode|enable_virgl)=" /run/droidspaces/container.config 2>/dev/null || true
        echo "=== device nodes ==="
        if [ -c /dev/kgsl-3d0 ]; then echo "KGSL_NODE=present"; else echo "KGSL_NODE=missing"; fi
        if [ -c /dev/ion ]; then echo "ION_NODE=present"; else echo "ION_NODE=missing"; fi
        if (exec 9<>/dev/kgsl-3d0) 2>/dev/null; then echo "KGSL_OPEN=ok"; else echo "KGSL_OPEN=failed"; fi
        if (exec 9<>/dev/ion) 2>/dev/null; then echo "ION_OPEN=ok"; else echo "ION_OPEN=failed"; fi
        echo "=== runtime GPU env file ==="
        grep -E "^(export )?(RCTOOLS_GPU_BACKEND|RCTOOLS_GPU_PRESENTATION|RCTOOLS_GPU_VIRTUALGL|LD_LIBRARY_PATH|LIBGL_DRIVERS_PATH|MESA_LOADER_DRIVER_OVERRIDE|__EGL_VENDOR_LIBRARY_FILENAMES|VGL_DISPLAY|VGL_FORCEALPHA|VGL_READBACK|GALLIUM_DRIVER|VTEST_SOCKET_NAME|LIBGL_ALWAYS_SOFTWARE|LD_PRELOAD)=" /run/droidspaces.env 2>/dev/null || true
        echo "=== GPU environment ==="
        env | grep -E "^(RCTOOLS_GPU_BACKEND|RCTOOLS_GPU_PRESENTATION|RCTOOLS_GPU_VIRTUALGL|LD_LIBRARY_PATH|LIBGL_DRIVERS_PATH|MESA_LOADER_DRIVER_OVERRIDE|__EGL_VENDOR_LIBRARY_FILENAMES|VGL_DISPLAY|VGL_FORCEALPHA|VGL_READBACK|GALLIUM_DRIVER|VTEST_SOCKET_NAME|LIBGL_ALWAYS_SOFTWARE|LD_PRELOAD)=" || true
    ' >"$pre" 2>&1 || {
        err "could not inspect running container"
        "$BB" tail -n 100 "$pre" >&2
        "$BB" rm -f "$pre"
        return 1
    }

    "$BB" cat "$pre"

    if [ "$backend" = freedreno ]; then
        if ! "$BB" grep -q '^enable_gpu_mode=1$' "$pre"; then
            err "DIRECT_GPU_CONFIG_NOT_LOADED"
            "$BB" rm -f "$pre"
            return 1
        fi
        if ! "$BB" grep -Fqx 'KGSL_NODE=present' "$pre" ||
           ! "$BB" grep -Fqx 'KGSL_OPEN=ok' "$pre"; then
            err "DIRECT_GPU_DEVICE_NOT_AVAILABLE"
            err "recent host KGSL/ZAP log:"
            dmesg | "$BB" grep -iE 'kgsl|adreno|a506|zap|pil|subsystem|firmware|Runtime PM' | "$BB" tail -n 80 >&2
            "$BB" rm -f "$pre"
            return 1
        fi

        if ! "$BB" grep -Fqx 'RCTOOLS_GPU_BACKEND=freedreno' "$pre" ||
           ! "$BB" grep -Fqx 'MESA_LOADER_DRIVER_OVERRIDE=kgsl' "$pre" ||
           ! "$BB" grep -Fq 'LIBGL_DRIVERS_PATH=' "$pre" ||
           ! "$BB" grep -Fq 'LD_LIBRARY_PATH=' "$pre"; then
            err "DIRECT_GPU_ENV_NOT_LOADED"
            err "DroidSpaces recovery run did not load the selected GPU environment"
            "$BB" rm -f "$pre"
            return 1
        fi

        if "$BB" grep -Fqx 'GALLIUM_DRIVER=virpipe' "$pre" ||
           "$BB" grep -Fqx 'LIBGL_ALWAYS_SOFTWARE=1' "$pre" ||
           "$BB" grep -Fq 'VTEST_SOCKET_NAME=' "$pre"; then
            err "DIRECT_GPU_ENV_CONFLICT"
            err "VirGL/llvmpipe variables are still active"
            "$BB" rm -f "$pre"
            return 1
        fi
    fi

    "$BB" rm -f "$pre"

    "$DS_BIN" --conf="$cfg" --env="$env" run sh -c '
        command -v eglinfo >/dev/null 2>&1 || exit 127
        eglinfo -B -p surfaceless 2>&1
    ' >"$log" 2>&1
    rc=$?

    if [ "$rc" -eq 127 ]; then
        err "eglinfo is not installed in the container"
        "$BB" rm -f "$log"
        return 1
    fi
    if [ "$rc" -ne 0 ]; then
        err "eglinfo failed (rc=$rc)"
        "$BB" tail -n 100 "$log" >&2
        "$BB" rm -f "$log"
        return 1
    fi

    case "$backend" in
        freedreno)
            "$BB" grep -q 'vendor: freedreno' "$log" &&
            "$BB" grep -q 'renderer: FD506' "$log" || {
                err "NOT_DIRECT_KGSL_RENDERER"
                "$BB" tail -n 100 "$log" >&2
                "$BB" rm -f "$log"
                return 1
            }
            say 'PASS DIRECT_KGSL_FD506'
            ;;
        llvmpipe)
            "$BB" grep -qi 'renderer: llvmpipe' "$log" || {
                err "llvmpipe validation failed"
                "$BB" tail -n 100 "$log" >&2
                "$BB" rm -f "$log"
                return 1
            }
            say 'PASS LLVMPIPE'
            ;;
        virgl)
            "$BB" grep -qi 'renderer:.*virgl' "$log" || {
                err "VirGL validation failed"
                "$BB" tail -n 100 "$log" >&2
                "$BB" rm -f "$log"
                return 1
            }
            say 'PASS VIRGL'
            ;;
        *)
            err "select a GPU backend first"
            "$BB" rm -f "$log"
            return 1
            ;;
    esac

    "$BB" grep -Ei 'vendor:|renderer:|OpenGL ES profile version:' "$log" | "$BB" head -n 12
    "$BB" rm -f "$log"
}

ensure_standard_root() {
    if [ -d "$DS_DEFAULT_ROOT" ]; then
        return 0
    fi

    say 'Mounting /data...'
    "$RCTOOLS" mount data rw >/dev/null 2>&1 || \
    "$RCTOOLS" mount data >/dev/null 2>&1 || true

    [ -d "$DS_DEFAULT_ROOT" ] || {
        err "DroidSpaces root not found after mounting /data: $DS_DEFAULT_ROOT"
        return 1
    }
}

scan_containers() {
    base="$1"
    list="/tmp/rctools-gpu-scan.$$"

    [ -d "$base" ] || {
        err "scan path does not exist: $base"
        return 1
    }

    "$BB" find "$base" -type f -name container.config 2>/dev/null |
        "$BB" sort >"$list"

    count="$("$BB" wc -l <"$list" | "$BB" tr -d ' ')"
    [ -n "$count" ] && [ "$count" -gt 0 ] || {
        err "no container.config found under: $base"
        "$BB" rm -f "$list"
        return 1
    }

    ui_title 'RCTools GPU - Select Container'
    printf '  Scan path: %s\n' "$base"
    say '------------------------------------------------------------'

    i=1
    while IFS= read -r cfg; do
        printf '  [%d] %s\n' "$i" "$(container_name "$cfg")"
        i=$((i + 1))
    done <"$list"

    say ''
    say '  [0] Back'
    say '------------------------------------------------------------'
    printf 'Select container > '
    IFS= read -r pick || {
        "$BB" rm -f "$list"
        return 1
    }

    case "$pick" in
        0)
            "$BB" rm -f "$list"
            return 2
            ;;
        ''|*[!0-9]*)
            err "invalid selection"
            "$BB" rm -f "$list"
            return 1
            ;;
    esac

    [ "$pick" -ge 1 ] && [ "$pick" -le "$count" ] || {
        err "invalid selection"
        "$BB" rm -f "$list"
        return 1
    }

    SELECTED_CFG="$("$BB" sed -n "$pick"p "$list")"
    "$BB" rm -f "$list"
}

choose_container() {
    while true; do
        ui_title 'RCTools GPU - Container Source'
        say '  Choose where RCTools should scan for containers.'
        say ''
        say '  [1] DroidSpaces default'
        say '      /data/local/Droidspaces'
        say ''
        say '  [2] Recovery temporary storage'
        say '      /tmp'
        say ''
        say '  [3] Custom path'
        say '      Enter an absolute path manually'
        say ''
        say '  [0] Back'
        say '------------------------------------------------------------'
        printf 'Select > '
        IFS= read -r pick || return 1

        case "$pick" in
            1)
                ensure_standard_root || {
                    ui_pause
                    continue
                }
                base="$DS_DEFAULT_ROOT"
                ;;
            2)
                base=/tmp
                ;;
            3)
                ui_clear
                printf 'Custom scan path: '
                IFS= read -r base || return 1
                case "$base" in
                    /*) ;;
                    *)
                        err "path must be absolute"
                        ui_pause
                        continue
                        ;;
                esac
                ;;
            0)
                return 2
                ;;
            *)
                err "invalid selection"
                ui_pause
                continue
                ;;
        esac

        if scan_containers "$base"; then
            return 0
        fi
        rc=$?
        [ "$rc" -eq 2 ] || ui_pause
    done
}

backend_action() {
    backend="$1"
    choose_container || return $?

    cfg="$SELECTED_CFG"
    ui_title 'RCTools GPU - Apply Backend'
    say "  Container : $(container_name "$cfg")"
    say "  Backend   : $backend"
    say '------------------------------------------------------------'

    save_backend "$cfg" "$backend" || {
        ui_pause
        return 1
    }

    if apply_backend "$cfg" "$backend"; then
        say ''
        say 'Configuration applied.'
        say 'Restart a running container so DroidSpaces reloads config and env.'
    else
        say ''
        err "backend saved but setup is incomplete"
        err "use 'rctools gpu tools' -> Setup/Status/Test"
    fi

    ui_pause
}

tools_action() {
    action="$1"
    choose_container || return $?

    cfg="$SELECTED_CFG"
    backend="$(saved_backend "$cfg")"

    ui_title "RCTools GPU Tools - $action"
    say "  Container : $(container_name "$cfg")"
    if [ -n "$backend" ]; then
        say "  Backend   : $backend"
    else
        say '  Backend   : none'
    fi
    say '------------------------------------------------------------'

    case "$action" in
        Setup)
            [ -n "$backend" ] || {
                err "select a backend from 'rctools gpu' first"
                ui_pause
                return 1
            }
            apply_backend "$cfg" "$backend"
            ;;
        Status)
            container_status "$cfg"
            ;;
        Enable)
            [ -n "$backend" ] || {
                err "no saved backend"
                ui_pause
                return 1
            }
            apply_backend "$cfg" "$backend"
            ;;
        Disable)
            disable_profile "$cfg"
            ;;
        Test)
            test_profile "$cfg"
            ;;
    esac

    ui_pause
}

