#!/sbin/sh
# Recovery-side DroidSpaces capability preflight.
# Read-only: does not insert, delete or flush firewall rules.

PATH=/sbin:/system/bin:/vendor/bin
export PATH

IPT=/sbin/iptables
FAIL=0
WARN=0

ok()   { printf '[OK]   %s\n' "$*"; }
bad()  { printf '[FAIL] %s\n' "$*"; FAIL=$((FAIL + 1)); }
warn() { printf '[WARN] %s\n' "$*"; WARN=$((WARN + 1)); }

check_file() {
    [ -e "$1" ] && ok "$1" || bad "$1 ausente"
}

check_cmd() {
    label="$1"
    shift
    if "$@" >/dev/null 2>&1; then
        ok "$label"
    else
        bad "$label"
    fi
}

printf 'DroidSpaces recovery requirements\n'
printf '%s\n' '--------------------------------'

if [ -x /sbin/recovery-time-sync ]; then
    ok 'recovery one-shot time repair'
    /sbin/recovery-time-sync status 2>/dev/null || warn 'time status unavailable'
else
    warn '/sbin/recovery-time-sync ausente; apt/TLS pode falhar se QCOM ATS estiver velho'
fi

for f in \
    /proc/self/ns/mnt \
    /proc/self/ns/pid \
    /proc/self/ns/uts \
    /proc/self/ns/ipc \
    /proc/self/ns/net \
    /proc/sys/net/ipv4/ip_forward
do
    check_file "$f"
done

[ -x /sbin/iptables.ds ] && ok 'iptables legacy static binary' || bad '/sbin/iptables.ds ausente'
[ -e /sbin/iptables ] && ok 'iptables frontend' || bad '/sbin/iptables ausente'
[ -e /sbin/iptables-save ] && ok 'iptables-save frontend' || bad '/sbin/iptables-save ausente'
[ -e /sbin/iptables-restore ] && ok 'iptables-restore frontend' || bad '/sbin/iptables-restore ausente'

if [ -x "$IPT" ]; then
    ver=$("$IPT" --version 2>&1 | head -n1)
    [ -n "$ver" ] && printf '[INFO] %s\n' "$ver"

    check_cmd 'iptables filter table' "$IPT" -t filter -L -n
    check_cmd 'iptables nat table' "$IPT" -t nat -L -n
    check_cmd 'iptables mangle table' "$IPT" -t mangle -L -n

    # Help-mode extension probes: userspace only, no firewall mutation.
    check_cmd 'xtables addrtype match' "$IPT" -m addrtype -h
    check_cmd 'xtables state match' "$IPT" -m state -h
    check_cmd 'xtables DNAT target' "$IPT" -t nat -j DNAT -h
    check_cmd 'xtables MASQUERADE target' "$IPT" -t nat -j MASQUERADE -h
    check_cmd 'xtables TCPMSS target' "$IPT" -t mangle -j TCPMSS -h
fi

if [ -r /proc/net/ip_tables_names ]; then
    for table in filter nat mangle; do
        grep -qx "$table" /proc/net/ip_tables_names 2>/dev/null \
            && ok "kernel ip_tables: $table" \
            || bad "kernel ip_tables sem tabela $table"
    done
else
    warn '/proc/net/ip_tables_names indisponível'
fi

if [ -r /proc/net/ip_tables_targets ]; then
    for target in DNAT MASQUERADE TCPMSS; do
        grep -qx "$target" /proc/net/ip_tables_targets 2>/dev/null \
            && ok "kernel xt target: $target" \
            || bad "kernel xt target ausente: $target"
    done
else
    bad '/proc/net/ip_tables_targets indisponível'
fi

if [ -r /proc/net/ip_tables_matches ]; then
    for match in tcp udp addrtype state; do
        grep -qx "$match" /proc/net/ip_tables_matches 2>/dev/null \
            && ok "kernel xt match: $match" \
            || bad "kernel xt match ausente: $match"
    done
else
    bad '/proc/net/ip_tables_matches indisponível'
fi

if [ -e /proc/sys/net/ipv4/conf/all/route_localnet ]; then
    [ -w /proc/sys/net/ipv4/conf/all/route_localnet ] \
        && ok 'route_localnet disponível e gravável' \
        || bad 'route_localnet existe mas não é gravável'
else
    bad 'route_localnet ausente; localhost port-forward não funcionará'
fi

# Optional/feature-dependent diagnostics.
[ -e /dev/loop-control ] && ok 'opcional: loop device para rootfs.img' || warn 'opcional: /dev/loop-control ausente (rootfs.img)'
command -v e2fsck >/dev/null 2>&1 && ok 'opcional: e2fsck para rootfs.img ext4' || warn 'opcional: e2fsck ausente (rootfs.img ext4)'
grep -qw overlay /proc/filesystems 2>/dev/null && ok 'opcional: OverlayFS/volatile' || warn 'opcional: OverlayFS indisponível'
[ -e /dev/fuse ] && ok 'opcional: FUSE' || warn 'opcional: /dev/fuse ausente'
[ -e /dev/net/tun ] && ok 'opcional: TUN/TAP' || warn 'opcional: /dev/net/tun ausente'
grep -qw cgroup2 /proc/filesystems 2>/dev/null \
    && ok 'cgroup2 disponível' \
    || warn 'cgroup2 ausente: DroidSpaces usará o caminho legacy de cgroup'
[ -e /proc/self/ns/user ] \
    && ok 'user namespace disponível' \
    || warn 'user namespace ausente: allow-sandboxing não funcionará'
[ -e /dev/ptmx ] \
    && ok 'PTY disponível' \
    || warn '/dev/ptmx ausente: consoles interativos podem falhar'

DS=""
if command -v droidspaces >/dev/null 2>&1; then
    DS=$(command -v droidspaces)
else
    for p in \
        /data/local/Droidspaces/droidspaces \
        /data/local/Droidspaces/bin/droidspaces \
        /sbin/droidspaces
    do
        [ -x "$p" ] && { DS="$p"; break; }
    done
fi

if [ -n "$DS" ]; then
    printf '\n[INFO] Executando diagnóstico nativo: %s check\n' "$DS"
    DS_OUT=$("$DS" check 2>&1)
    DS_RC=$?
    printf '%s\n' "$DS_OUT"
    if [ "$DS_RC" -ne 0 ] || printf '%s\n' "$DS_OUT" | grep -q 'required feature(s) missing'; then
        bad 'droidspaces check detectou requisito obrigatório ausente'
    else
        ok 'droidspaces check'
    fi
else
    warn 'binário DroidSpaces ainda não instalado; diagnóstico nativo ignorado'
fi

printf '\nResumo: %s falha(s), %s aviso(s).\n' "$FAIL" "$WARN"
[ "$FAIL" -eq 0 ]
