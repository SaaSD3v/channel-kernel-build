    const xcb_query_extension_reply_t *extension;
 
-   const char *env = getenv("MESA_LOADER_DRIVER_OVERRIDE");
-   if (env && !strcmp(env, "kgsl"))
-      return open("/dev/kgsl-3d0", O_RDWR);
-
-   xcb_prefetch_extension_data(conn, &xcb_dri3_id);
-   extension = xcb_get_extension_data(conn, &xcb_dri3_id);
-   if (!(extension && extension->present))
-      return -1;
+   xcb_prefetch_extension_data(conn, &xcb_dri3_id);
+   extension = xcb_get_extension_data(conn, &xcb_dri3_id);
+   if (!(extension && extension->present))
+      return -1;
+
+   /*
+    * The KGSL backend does not use xcb_dri3_open() to obtain a DRM fd, but
+    * callers selecting the DRI3 GLX path still require a real DRI3 server.
+    * Do not force that path on X servers such as TigerVNC that do not expose
+    * DRI3.
+    */
+   const char *env = getenv("MESA_LOADER_DRIVER_OVERRIDE");
+   if (env && !strcmp(env, "kgsl"))
+      return open("/dev/kgsl-3d0", O_RDWR);
 
    cookie = xcb_dri3_open(conn,
                           root,
