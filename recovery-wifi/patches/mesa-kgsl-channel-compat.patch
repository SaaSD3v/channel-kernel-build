-      return open("/dev/kgsl-3d0", O_RDWR);
-
-   xcb_prefetch_extension_data(conn, &xcb_dri3_id);
-   extension = xcb_get_extension_data(conn, &xcb_dri3_id);
-   if (!(extension && extension->present))
