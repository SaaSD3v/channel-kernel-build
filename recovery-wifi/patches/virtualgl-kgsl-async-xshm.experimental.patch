+bool FBXFrame::redrawAsync(void)
+{
+	#ifdef _WIN32
+	return false;
+	#else
+	if(!fb.shm || fb.pm)
+		return false;
+
+	if(flags & FRAME_BOTTOMUP) TRY_FBX(fbx_flip(&fb, 0, 0, 0, 0));
+	TRY_FBX(fbx_awrite_event(&fb, 0, 0, 0, 0, fb.width, fb.height));
+	return true;
+	#endif
+}
+
+
+void FBXFrame::syncAsync(void)
+{
+	#ifndef _WIN32
+	TRY_FBX(fbx_wait_shm(&fb));
+	#endif
+}
