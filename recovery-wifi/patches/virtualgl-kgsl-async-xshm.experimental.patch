+void X11Trans::run(void)
+{
+	Timer timer, sleepTimer;  double err = 0.;  bool first = true;
+	FBXFrame *pending[2] = { NULL, NULL };
+	int nPending = 0;
+	bool asyncReported = false;
+
+	try
+	{
+		_vgl_disableFaker();
+
+		while(!deadYet)
+		{
+			FBXFrame *f;  void *ftemp = NULL;
+
+			q.get(&ftemp);
+			if(deadYet) break;
+			f = (FBXFrame *)ftemp;
+			if(!f) THROW("Queue has been shut down");
+			ready.signal();
+
+			profBlit.startFrame();
+			bool async = kgslAsyncXShm && f->redrawAsync();
+			if(async && !asyncReported)
+			{
+				if(fconfig.verbose)
+					vglout.println("[VGL] KGSL async MIT-SHM presentation active");
+				asyncReported = true;
+			}
+			if(!async)
+			{
+				/*
+				 * A resize or XShm allocation failure can make one frame fall
+				 * back to the synchronous FBX path.  Frames use independent X
+				 * connections, so drain earlier async submissions first to keep
+				 * presentation order and to return those buffers to the pool.
+				 */
+				for(int i = 0; i < nPending; i++)
+				{
+					pending[i]->syncAsync();
+					pending[i]->signalComplete();
+					pending[i] = NULL;
+				}
+				nPending = 0;
+				f->redraw();
+			}
+			profBlit.endFrame(f->hdr.width * f->hdr.height, 0, 1);
+
+			profTotal.endFrame(f->hdr.width * f->hdr.height, 0, 1);
+			profTotal.startFrame();
+
+			if(fconfig.flushdelay > 0.)
+			{
+				long usec = (long)(fconfig.flushdelay * 1000000.);
+				if(usec > 0) usleep(usec);
+			}
+			if(fconfig.fps > 0.)
+			{
+				double elapsed = timer.elapsed();
+				if(first) first = false;
+				else
+				{
+					if(elapsed < 1. / fconfig.fps)
+					{
+						sleepTimer.start();
+						long usec = (long)((1. / fconfig.fps - elapsed - err) * 1000000.);
+						if(usec > 0) usleep(usec);
+						double sleepTime = sleepTimer.elapsed();
+						err = sleepTime - (1. / fconfig.fps - elapsed - err);
+						if(err < 0.) err = 0.;
+					}
+				}
+				timer.start();
+			}
+
+			if(async)
+			{
+				pending[nPending++] = f;
+
+				/* Match the proven two-buffer Channel bridge: keep two shared
+				 * images in flight, then wait only for the oldest completion.
+				 * Async mode needs four pool frames so two in-flight images,
+				 * one queued/spoilable frame, and the producer can coexist.
+				 */
+				if(nPending == 2)
+				{
+					pending[0]->syncAsync();
+					pending[0]->signalComplete();
+					pending[0] = pending[1];
+					pending[1] = NULL;
+					nPending = 1;
+				}
+			}
+			else
+				f->signalComplete();
+		}
+
+		for(int i = 0; i < nPending; i++)
+		{
+			pending[i]->syncAsync();
+			pending[i]->signalComplete();
+			pending[i] = NULL;
+		}
+		nPending = 0;
+	}
+	catch(std::exception &e)
+	{
+		for(int i = 0; i < nPending; i++)
+			if(pending[i]) pending[i]->signalComplete();
 		if(thread) thread->setError(e);
 		ready.signal();
 		_vgl_enableFaker();

