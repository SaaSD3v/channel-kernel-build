+static int
+fbx_awrite_impl(fbx_struct *fb, int srcX_, int srcY_, int dstX_, int dstY_,
+	int width_, int height_, int sendShmCompletion)
+{
+	int srcX, srcY, dstX, dstY, width, height;
+
+	if(!fb) THROW("Invalid argument");
+
+	srcX = srcX_ >= 0 ? srcX_ : 0;  srcY = srcY_ >= 0 ? srcY_ : 0;
+	dstX = dstX_ >= 0 ? dstX_ : 0;  dstY = dstY_ >= 0 ? dstY_ : 0;
+	width = width_ > 0 ? width_ : fb->width;
+	height = height_ > 0 ? height_ : fb->height;
+
+	if(width > fb->width) width = fb->width;
+	if(height > fb->height) height = fb->height;
+	if(srcX + width > fb->width) width = fb->width - srcX;
+	if(srcY + height > fb->height) height = fb->height - srcY;
+	if(!fb->wh.dpy || !fb->wh.d || !fb->xi || !fb->bits)
+		THROW("Not initialized");
+
+	#ifdef USESHM
+	if(fb->shm)
+	{
+		if(!fb->xattach)
+		{
+			TRY_X11(XShmAttach(fb->wh.dpy, &fb->shminfo));  fb->xattach = 1;
+		}
+		TRY_X11(XShmPutImage(fb->wh.dpy, fb->wh.d, fb->xgc, fb->xi, srcX, srcY,
+			dstX, dstY, width, height, sendShmCompletion ? True : False));
+		if(sendShmCompletion)
+			XFlush(fb->wh.dpy);
+	}
+	else
+	#endif
+	{
+		Drawable draw = fb->pixmap ? fb->wh.d : fb->pm;
+		if(draw == fb->pm) dstX = dstY = 0;
+		XPutImage(fb->wh.dpy, draw, fb->xgc, fb->xi, srcX, srcY, dstX, dstY, width,
+			height);
+	}
+	return 0;
+
+	finally:
+	return -1;
+}
+
+
+int fbx_awrite(fbx_struct *fb, int srcX, int srcY, int dstX, int dstY,
+	int width, int height)
+{
+	return fbx_awrite_impl(fb, srcX, srcY, dstX, dstY, width, height, 0);
+}
+
+
+int fbx_awrite_event(fbx_struct *fb, int srcX, int srcY, int dstX, int dstY,
+	int width, int height)
+{
+	if(!fb || !fb->shm || fb->pm)
+		THROW("MIT-SHM image is required");
+
+	return fbx_awrite_impl(fb, srcX, srcY, dstX, dstY, width, height, 1);
+
+	finally:
+	return -1;
+}
+
+
+#ifdef USESHM
+typedef struct _fbx_shm_completion_match
+{
+	int eventType;
+	ShmSeg shmseg;
+} fbx_shm_completion_match;
+
+
+static Bool
+fbx_shm_completion(Display *dpy, XEvent *event, XPointer arg)
+{
+	(void)dpy;
+	const fbx_shm_completion_match *match =
+		(const fbx_shm_completion_match *)arg;
+	if(!match || event->type != match->eventType)
+		return False;
+
+	XShmCompletionEvent *completion = (XShmCompletionEvent *)event;
+	return completion->shmseg == match->shmseg ? True : False;
+}
+#endif
+
+
+int fbx_wait_shm(fbx_struct *fb)
+{
+	#ifdef USESHM
+	XEvent event;
+
+	if(!fb || !fb->wh.dpy || !fb->shm || fb->pm)
+		THROW("MIT-SHM image is required");
+
+	/*
+	 * XIfEvent() invokes predicates with the Display locked when Xlib is
+	 * threaded.  Xlib predicates must not call Xlib functions, so resolve the
+	 * MIT-SHM event base before entering XIfEvent() and pass only plain data to
+	 * the predicate.
+	 */
+	int eventBase = XShmGetEventBase(fb->wh.dpy);
+	if(eventBase < 0)
+		THROW("Could not obtain MIT-SHM event base");
+
+	fbx_shm_completion_match match = {
+		.eventType = eventBase + ShmCompletion,
+		.shmseg = fb->shminfo.shmseg,
+	};
+
+	XIfEvent(fb->wh.dpy, &event, fbx_shm_completion, (XPointer)&match);
+	return 0;
+
+	finally:
+	return -1;
+	#else
+	(void)fb;
+	return -1;
+	#endif
 }
 
 #endif
