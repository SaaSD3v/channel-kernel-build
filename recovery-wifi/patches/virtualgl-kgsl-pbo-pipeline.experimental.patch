+bool VirtualDrawable::readPixels(GLint x, GLint y, GLint width, GLint pitch,
+	GLint height, GLenum glFormat, PF *pf, GLubyte *bits, GLint readBuf,
+	bool stereo, bool topDown)
+{
+	double t0 = 0.0, tRead, tTotal;
+	bool packInvert = false;
+	GLint oldPackInvert = 0;
+	GLenum type = GL_UNSIGNED_BYTE;
+
+	// Compute OpenGL format from pixel format of frame
+	if(glFormat == GL_NONE)
+	{
+		glFormat = pf_glformat[pf->id];  type = pf_gldatatype[pf->id];
+	}
+	if(glFormat == GL_NONE) THROW("Unsupported pixel format");
+
+	// Whenever the readback format changes (perhaps due to switching
+	// compression or transports), then reset the PBO synchronicity detector
+	int currentFormat =
+		(glFormat == GL_GREEN || glFormat == GL_BLUE) ? GL_RED : glFormat;
+	if(lastFormat >= 0 && lastFormat != currentFormat)
+	{
+		usePBO = (fconfig.readback == RRREAD_PBO);
+		numSync = numFrames = 0;
+		alreadyPrinted = alreadyWarned = false;
+	}
+	lastFormat = currentFormat;
+
+	if(!checkRenderMode()) return false;
+
+	initReadbackContext();
+	TempContext tc(edpy != EGL_NO_DISPLAY ? (Display *)edpy : dpy,
+		getGLXDrawable(), getGLXDrawable(), ctx, edpy != EGL_NO_DISPLAY);
+
+	backend::readBuffer(readBuf);
+
+	#ifdef GL_PACK_INVERT_MESA
+	if(topDown && has_gl_extension("GL_MESA_pack_invert"))
+	{
+		_glGetIntegerv(GL_PACK_INVERT_MESA, &oldPackInvert);
+		packInvert = true;
+	}
+	#endif
+
+	if(pitch % 8 == 0) _glPixelStorei(GL_PACK_ALIGNMENT, 8);
+	else if(pitch % 4 == 0) _glPixelStorei(GL_PACK_ALIGNMENT, 4);
+	else if(pitch % 2 == 0) _glPixelStorei(GL_PACK_ALIGNMENT, 2);
+	else if(pitch % 1 == 0) _glPixelStorei(GL_PACK_ALIGNMENT, 1);
+
+	const char *kgslPboEnv = getenv("VGL_KGSL_PBO_PIPELINE");
+	const char *vglDisplay = getenv("VGL_DISPLAY");
+	bool kgslPboPipeline =
+		kgslPboEnv && !strcmp(kgslPboEnv, "1")
+		&& vglDisplay && !strcmp(vglDisplay, "eglkgsl")
+		&& topDown && packInvert && !stereo && !fconfig.autotest
+		&& x == 0 && y == 0 && oglDraw
+		&& width == oglDraw->getWidth() && height == oglDraw->getHeight()
+		&& pitch == width * pf->size
+		&& has_gl_extension("GL_ARB_pixel_buffer_object");
+
+	if(!kgslPboPipeline)
+		kgslPboPrimed = false;
+
+	if(kgslPboPipeline)
+	{
+		if(!kgslPbo[0] || !kgslPbo[1])
+		{
+			_glGenBuffers(2, kgslPbo);
+			if(!kgslPbo[0] || !kgslPbo[1])
+				THROW("Could not generate KGSL PBO pipeline buffers");
+			kgslPboPrimed = false;
+			kgslPboNext = 0;
+		}
+
+		bool layoutChanged =
+			kgslPboWidth != width || kgslPboHeight != height
+			|| kgslPboPitch != pitch || kgslPboFormat != glFormat
+			|| kgslPboType != type || kgslPboReadBuf != readBuf;
+
+		if(layoutChanged)
+		{
+			for(int i = 0; i < 2; i++)
+			{
+				_glBindBuffer(GL_PIXEL_PACK_BUFFER_EXT, kgslPbo[i]);
+				_glBufferData(GL_PIXEL_PACK_BUFFER_EXT, pitch * height, NULL,
+					GL_STREAM_READ);
+				int size = 0;
+				_glGetBufferParameteriv(GL_PIXEL_PACK_BUFFER_EXT, GL_BUFFER_SIZE,
+					&size);
+				if(size != pitch * height)
+					THROW("Could not set KGSL PBO pipeline size");
+			}
+			_glBindBuffer(GL_PIXEL_PACK_BUFFER_EXT, 0);
+			kgslPboWidth = width;
+			kgslPboHeight = height;
+			kgslPboPitch = pitch;
+			kgslPboFormat = glFormat;
+			kgslPboType = type;
+			kgslPboReadBuf = readBuf;
+			kgslPboNext = 0;
+			kgslPboPrimed = false;
+		}
+
+		if(!kgslPboReported && fconfig.verbose)
+		{
+			vglout.println("[VGL] KGSL two-PBO readback pipeline active");
+			kgslPboReported = true;
+		}
+	}
+	else if(usePBO)
+	{
+		if(!ext)
+		{
+			if(!has_gl_extension("GL_ARB_pixel_buffer_object"))
+				THROW("GL_ARB_pixel_buffer_object extension not available");
+			ext = "GL_ARB_pixel_buffer_object";
+		}
+		if(!pbo) _glGenBuffers(1, &pbo);
+		if(!pbo) THROW("Could not generate pixel buffer object");
+		if(!alreadyPrinted && fconfig.verbose)
+		{
+			vglout.println("[VGL] Using pixel buffer objects for readback (%s --> %s)",
+				formatString(oglDraw->getFormat()), formatString(glFormat));
+			alreadyPrinted = true;
+		}
+		_glBindBuffer(GL_PIXEL_PACK_BUFFER_EXT, pbo);
+		int size = 0;
+		_glGetBufferParameteriv(GL_PIXEL_PACK_BUFFER_EXT, GL_BUFFER_SIZE, &size);
+		if(size != pitch * height)
+			_glBufferData(GL_PIXEL_PACK_BUFFER_EXT, pitch * height, NULL,
+				GL_STREAM_READ);
+		_glGetBufferParameteriv(GL_PIXEL_PACK_BUFFER_EXT, GL_BUFFER_SIZE, &size);
+		if(size != pitch * height)
+			THROW("Could not set PBO size");
+	}
+	else
+	{
+		if(!alreadyPrinted && fconfig.verbose)
+		{
+			vglout.println("[VGL] Using synchronous readback (%s --> %s)",
+				formatString(oglDraw->getFormat()), formatString(glFormat));
+			alreadyPrinted = true;
+		}
+	}
+
+	TRY_GL();
+	profReadback.startFrame();
+
+	bool kgslPboCommitPrime = false;
+	int kgslPboCommitNext = -1;
+
+	if(kgslPboPipeline)
+	{
+		int current = kgslPboNext;
+		int previous = 1 - current;
+
+		if(kgslPboPrimed)
+		{
+			_glBindBuffer(GL_PIXEL_PACK_BUFFER_EXT, kgslPbo[previous]);
+			unsigned char *pboBits =
+				(unsigned char *)_glMapBuffer(GL_PIXEL_PACK_BUFFER_EXT, GL_READ_ONLY);
+			if(!pboBits)
+				THROW("Could not map previous KGSL PBO");
+			memcpy(bits, pboBits, pitch * height);
+			if(!_glUnmapBuffer(GL_PIXEL_PACK_BUFFER_EXT))
+				THROW("Could not unmap previous KGSL PBO");
+		}
+
+		_glBindBuffer(GL_PIXEL_PACK_BUFFER_EXT, kgslPbo[current]);
+		#ifdef GL_PACK_INVERT_MESA
+		_glPixelStorei(GL_PACK_INVERT_MESA, GL_TRUE);
+		#endif
+		backend::readPixels(x, y, width, height, glFormat, type, NULL);
+		#ifdef GL_PACK_INVERT_MESA
+		_glPixelStorei(GL_PACK_INVERT_MESA, oldPackInvert);
+		#endif
+		_glFlush();
+
+		if(!kgslPboPrimed)
+		{
+			unsigned char *pboBits =
+				(unsigned char *)_glMapBuffer(GL_PIXEL_PACK_BUFFER_EXT, GL_READ_ONLY);
+			if(!pboBits)
+				THROW("Could not map initial KGSL PBO");
+			memcpy(bits, pboBits, pitch * height);
+			if(!_glUnmapBuffer(GL_PIXEL_PACK_BUFFER_EXT))
+				THROW("Could not unmap initial KGSL PBO");
+			kgslPboCommitPrime = true;
+		}
+
+		_glBindBuffer(GL_PIXEL_PACK_BUFFER_EXT, 0);
+		kgslPboCommitNext = previous;
+	}
+	else
+	{
+		if(usePBO) t0 = GetTime();
+		#ifdef GL_PACK_INVERT_MESA
+		if(packInvert)
+			_glPixelStorei(GL_PACK_INVERT_MESA, GL_TRUE);
+		#endif
+		backend::readPixels(x, y, width, height, glFormat, type,
+			usePBO ? NULL : bits);
+		#ifdef GL_PACK_INVERT_MESA
+		if(packInvert)
+			_glPixelStorei(GL_PACK_INVERT_MESA, oldPackInvert);
+		#endif
+	}
+
+	if(!kgslPboPipeline && usePBO)
+	{
+		tRead = GetTime() - t0;
+		unsigned char *pboBits = NULL;
+		pboBits = (unsigned char *)_glMapBuffer(GL_PIXEL_PACK_BUFFER_EXT,
+			GL_READ_ONLY);
+		if(!pboBits) THROW("Could not map pixel buffer object");
+		memcpy(bits, pboBits, pitch * height);
+		if(!_glUnmapBuffer(GL_PIXEL_PACK_BUFFER_EXT))
+			THROW("Could not unmap pixel buffer object");
+		_glBindBuffer(GL_PIXEL_PACK_BUFFER_EXT, 0);
+		tTotal = GetTime() - t0;
+		numFrames++;
+		if(tRead / tTotal > 0.5 && numFrames <= 10)
+		{
+			numSync++;
+			if(numSync >= 10 && !alreadyWarned && fconfig.verbose)
+			{
+				vglout.println("[VGL] NOTICE: PBO readback is not behaving asynchronously.  Disabling PBOs.");
+				if(glFormat != oglDraw->getFormat())
+				{
+					vglout.println("[VGL]    This could be due to a mismatch between the readback pixel format");
+					vglout.println("[VGL]    (%s) and the Pbuffer pixel format (%s).",
+						formatString(glFormat), formatString(oglDraw->getFormat()));
+					if(((oglDraw->getFormat() == GL_BGRA && glFormat == GL_BGR)
+						|| (oglDraw->getFormat() == GL_RGBA && glFormat == GL_RGB))
+						&& fconfig.forcealpha)
+						vglout.println("[VGL]    Try setting VGL_FORCEALPHA=0.");
+					else if(((oglDraw->getFormat() == GL_BGR && glFormat == GL_BGRA)
+						|| (oglDraw->getFormat() == GL_RGB && glFormat == GL_RGBA))
+						&& !fconfig.forcealpha)
+						vglout.println("[VGL]    Try setting VGL_FORCEALPHA=1.");
+				}
+				alreadyWarned = true;
+			}
+		}
+	}
+
+	profReadback.endFrame(width * height, 0, stereo ? 0.5 : 1);
+	CATCH_GL("Could not read pixels");
+
+	if(kgslPboPipeline)
+	{
+		if(kgslPboCommitPrime)
+			kgslPboPrimed = true;
+		if(kgslPboCommitNext >= 0)
+			kgslPboNext = kgslPboCommitNext;
+	}
 
 	// If automatic faker testing is enabled, store the FB color in an
 	// environment variable so the test program can verify it
