+static const char *formatString(int glFormat)
+{
+	switch(glFormat)
+	{
+		case GL_RGB:       return "RGB";
+		case GL_RGBA:      return "RGBA";
+		case GL_BGR:       return "BGR";
+		case GL_BGRA:      return "BGRA";
+		#ifdef GL_ABGR_EXT
+		case GL_ABGR_EXT:  return "ABGR";
+		#endif
+		case GL_RED:       return "COMPONENT";
+		default:           return "????";
+	}
