#!/sbin/sh
# Recovery Wi-Fi controller for Motorola channel (Moto G7 Play / SDM632).
# Self-contained userspace: static wpa_supplicant + BusyBox + WCNSS helper.

PATH=/sbin:/system/bin:/vendor/bin
export PATH

# Recovery /data may be encrypted or unavailable. Keep every temporary file in
# the recovery-owned tmpfs instead of inheriting Android's /data/local default.
TMPDIR=/tmp
TMP=/tmp
TEMP=/tmp
export TMPDIR TMP TEMP

BB=/sbin/busybox.ds
WPA=/sbin/wpa_supplicant.ds
WPACLI=/sbin/wpa_cli.ds
WPAPASS=/sbin/wpa_passphrase.ds
WCNSS=/sbin/wcnss-recovery
STATE=/tmp/ds-wifi
STOCK_VENDOR="$STATE/vendor-stock"
CTRL="$STATE/ctrl"
CONF="$STATE/wpa_supplicant.conf"
LOG="$STATE/wpa_supplicant.log"
PREPLOG="$STATE/prepare.log"
UDHCPC_SCRIPT=/sbin/wifi-udhcpc.script
PERSIST_DIR=/data/local/wifi
PERSIST_NETWORKS=$PERSIST_DIR/networks
PERSIST_VERSION=$PERSIST_DIR/.version
CANDIDATE=$STATE/candidate.conf
PERSIST_COUNT=0
PERSIST_HOTSPOT=$PERSIST_DIR/hotspot.conf
HOTSPOT_CONF=$STATE/hotspot.conf
HOTSPOT_MARKER=$STATE/hotspot.active
HOTSPOT_LOG=$STATE/hotspot.log
HOTSPOT_DHCP=$STATE/udhcpd.conf
HOTSPOT_LEASES=$STATE/udhcpd.leases
HOTSPOT_PID=$STATE/udhcpd.pid
HOTSPOT_DHCP_LOG=$STATE/udhcpd.log
HOTSPOT_ADDR=192.168.43.1
HOTSPOT_CIDR=192.168.43.1/24
IFACE=${WIFI_IFACE:-wlan0}

mkdir_state() {
    "$BB" mkdir -p "$STATE" "$CTRL" "$STOCK_VENDOR" /vendor /firmware /persist \
        /mnt/vendor/persist /lib/firmware/wlan/prima 2>/dev/null || true
    "$BB" chmod 700 "$STATE" 2>/dev/null || true
}

log() {
    mkdir_state
    echo "[wifi] $*" | "$BB" tee -a "$PREPLOG"
}

is_mounted() {
    "$BB" grep -q " $1 " /proc/mounts 2>/dev/null
}


# /data/local/wifi is the root-only persistent database. /tmp/ds-wifi remains
# the runtime area for sockets, PID files, candidates and the active aggregate.
data_partition_mounted() {
    "$BB" awk '$2 == "/data" && $1 ~ /^\/dev\/block\// { ok=1 } END { exit ok ? 0 : 1 }' /proc/mounts 2>/dev/null
}

ensure_persistent_store() {
    if ! data_partition_mounted; then
        if command -v twrp >/dev/null 2>&1; then
            twrp mount data >/dev/null 2>&1 || true
        fi
    fi

    data_partition_mounted || return 1

    "$BB" mkdir -p "$PERSIST_NETWORKS" 2>/dev/null || return 1
    "$BB" chmod 700 "$PERSIST_DIR" "$PERSIST_NETWORKS" 2>/dev/null || return 1
    "$BB" chown 0:0 "$PERSIST_DIR" "$PERSIST_NETWORKS" 2>/dev/null || return 1

    if [ -f "$PERSIST_VERSION" ]; then
        ver=$(cat "$PERSIST_VERSION" 2>/dev/null)
        [ "$ver" = "1" ] || {
            echo "Unsupported Wi-Fi database version: $ver" >&2
            return 1
        }
    else
        vtmp="$PERSIST_DIR/.version.$$"
        printf '%s\n' '1' > "$vtmp" || return 1
        "$BB" chmod 600 "$vtmp" 2>/dev/null || { "$BB" rm -f "$vtmp"; return 1; }
        "$BB" chown 0:0 "$vtmp" 2>/dev/null || { "$BB" rm -f "$vtmp"; return 1; }
        "$BB" mv -f "$vtmp" "$PERSIST_VERSION" || { "$BB" rm -f "$vtmp"; return 1; }
    fi

    recover_buggy_pending_profiles
    return 0
}

network_id() {
    nid=$(printf '%s' "$1" | "$BB" sha256sum 2>/dev/null | "$BB" awk '{print $1}')
    [ -n "$nid" ] || return 1
    printf '%s\n' "$nid"
}

recover_buggy_pending_profiles() {
    for rb_pending in "$PERSIST_NETWORKS"/.*.*; do
        [ -f "$rb_pending" ] || continue
        rb_name="${rb_pending##*/}"
        rb_rest="${rb_name#.}"
        rb_hash="${rb_rest%%.*}"

        [ "${#rb_hash}" -eq 64 ] || continue
        case "$rb_hash" in
            *[!0-9a-f]*) continue ;;
        esac

        "$BB" grep -qx '# dswifi-db=1' "$rb_pending" 2>/dev/null || continue
        "$BB" grep -q '^[[:space:]]*network[[:space:]]*={' "$rb_pending" 2>/dev/null || continue

        rb_final="$PERSIST_NETWORKS/$rb_hash.conf"
        if [ -f "$rb_final" ]; then
            "$BB" rm -f "$rb_pending"
            continue
        fi

        "$BB" chmod 600 "$rb_pending" 2>/dev/null || continue
        "$BB" chown 0:0 "$rb_pending" 2>/dev/null || continue
        if "$BB" mv -f "$rb_pending" "$rb_final"; then
            log "recovered validated Wi-Fi profile from run #14"
        fi
    done
}

slot_suffix() {
    s="$(getprop ro.boot.slot_suffix 2>/dev/null)"
    case "$s" in
        _a|_b) printf '%s' "$s" ;;
        *)
            s="$(getprop ro.boot.slot 2>/dev/null)"
            case "$s" in a|b) printf '_%s' "$s" ;; *) printf '' ;; esac
            ;;
    esac
}

find_block() {
    base="$1"
    slot="$(slot_suffix)"
    for n in "${base}${slot}" "$base"; do
        [ -n "$n" ] || continue
        for root in \
            /dev/block/bootdevice/by-name \
            /dev/block/platform/soc/7824900.sdhci/by-name \
            /dev/block/platform/soc/c0c4000.sdhci/by-name
        do
            [ -e "$root/$n" ] && { echo "$root/$n"; return 0; }
        done
    done
    return 1
}

mount_partition() {
    target="$1"
    part="$2"
    [ -d "$target" ] || "$BB" mkdir -p "$target"
    is_mounted "$target" && return 0
    dev="$(find_block "$part" 2>/dev/null || true)"
    [ -n "$dev" ] || return 1
    # Let mount auto-detect first; recovery partitions differ between firmware revisions.
    "$BB" mount -o ro "$dev" "$target" 2>/dev/null || \
    "$BB" mount -t ext4 -o ro "$dev" "$target" 2>/dev/null || \
    "$BB" mount -t vfat -o ro "$dev" "$target" 2>/dev/null
}

stage_firmware() {
    "$BB" mkdir -p /lib/firmware/wlan/prima 2>/dev/null || true

    # Motorola's sdm632-common tree creates /vendor/firmware/wlan/prima
    # symlinks that point absolutely to /vendor/etc/wifi. Because recovery
    # keeps its own /vendor visible and mounts stock vendor privately, copy the
    # actual WCNSS files from the stock vendor source directory instead of
    # following those broken absolute symlinks.
    if [ -d "$STOCK_VENDOR/etc/wifi" ]; then
        for src in "$STOCK_VENDOR"/etc/wifi/WCNSS_*; do
            [ -s "$src" ] || continue
            name="${src##*/}"
            "$BB" cat "$src" > "/lib/firmware/wlan/prima/$name" 2>/dev/null || true
            [ -s "/lib/firmware/wlan/prima/$name" ] && log "staged stock WLAN firmware $name"
        done
    fi

    # Some Motorola firmware revisions carry real files in this directory,
    # while Lineage-style vendor images populate it with absolute symlinks.
    # Copy only real files here; broken/absolute symlinks are already handled
    # through the stock vendor /etc/wifi source above.
    if [ -d "$STOCK_VENDOR/firmware/wlan/prima" ]; then
        for src in "$STOCK_VENDOR"/firmware/wlan/prima/WCNSS_*; do
            [ -L "$src" ] && continue
            [ -s "$src" ] || continue
            name="${src##*/}"
            "$BB" cat "$src" > "/lib/firmware/wlan/prima/$name" 2>/dev/null || true
            [ -s "/lib/firmware/wlan/prima/$name" ] && log "staged vendor WLAN firmware $name"
        done
    fi

    # Stock calibration/NV data live on persist on many Motorola builds.
    # Stage them before PRONTO is kickstarted because request_firmware() runs
    # synchronously inside the fwpath parameter write; feeding a later fallback
    # request from this same shell would be too late.
    for root in /mnt/vendor/persist /persist; do
        [ -d "$root" ] || continue
        for src in "$root"/WCNSS_*; do
            [ -s "$src" ] || continue
            name="${src##*/}"
            "$BB" cat "$src" > "/lib/firmware/wlan/prima/$name" 2>/dev/null || true
            [ -s "/lib/firmware/wlan/prima/$name" ] && log "staged persist WLAN data $name"
        done

        if [ ! -s "$STATE/WCNSS_qcom_wlan_cal.bin" ] &&
           [ -s "$root/WCNSS_qcom_wlan_cal.bin" ]; then
            "$BB" cat "$root/WCNSS_qcom_wlan_cal.bin" >                 "$STATE/WCNSS_qcom_wlan_cal.bin" 2>/dev/null || true
            [ -s "$STATE/WCNSS_qcom_wlan_cal.bin" ] &&
                log "seeded stock WCNSS calibration from $root"
        fi
    done

    # PIL loads the WCNSS subsystem before the PRONTO network driver starts.
    # Stage the modem partition's WCNSS image into the same firmware root so
    # both PIL (wcnss.mdt/bXX) and request_firmware(wlan/prima/...) resolve
    # with one firmware_class.path.
    modem_root=""
    for root in /vendor/firmware_mnt/image /firmware/image; do
        if [ -d "$root" ]; then
            modem_root="$root"
            break
        fi
    done
    if [ -n "$modem_root" ]; then
        for src in "$modem_root"/wcnss.* "$modem_root"/WCNSS.*; do
            [ -s "$src" ] || continue
            name="${src##*/}"
            "$BB" cat "$src" > "/lib/firmware/$name" 2>/dev/null || true
            [ -s "/lib/firmware/$name" ] && log "staged modem firmware $name"
        done
    fi
}

feed_pending_firmware() {
    # CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y in the channel kernel. Firmware
    # class replaces '/' with '!' in fallback sysfs node names, so decode it
    # before looking up wlan/prima paths.
    for req in /sys/class/firmware/*; do
        [ -e "$req/loading" ] || continue
        req_name="${req##*/}"
        name="$(printf '%s' "$req_name" | "$BB" sed 's|!|/|g')"
        base="${name##*/}"
        src=""
        for p in \
            "/lib/firmware/$name" \
            "/lib/firmware/wlan/prima/$base" \
            "$STOCK_VENDOR/etc/wifi/$base" \
            "/vendor/firmware_mnt/image/$base" \
            "/firmware/image/$base" \
            "/mnt/vendor/persist/$base" \
            "/persist/$base"
        do
            [ -f "$p" ] && { src="$p"; break; }
        done
        [ -n "$src" ] || continue
        log "feeding pending firmware $name from $src"
        if echo 1 > "$req/loading" 2>/dev/null; then
            "$BB" cat "$src" > "$req/data" 2>/dev/null || true
            echo 0 > "$req/loading" 2>/dev/null || true
        fi
    done
}

prepare() {
    mkdir_state
    : > "$PREPLOG"

    # Keep the recovery ramdisk's /vendor visible. If TWRP has not already
    # mounted the stock vendor partition, mount it read-only at a private path.
    if is_mounted /vendor; then
        STOCK_VENDOR=/vendor
        log "vendor already mounted by recovery; using /vendor"
    elif mount_partition "$STOCK_VENDOR" vendor; then
        log "vendor stock mounted read-only at $STOCK_VENDOR"
    else
        log "vendor stock mount unavailable"
    fi

    mount_partition /firmware modem && log "firmware/modem mounted at /firmware" || log "firmware mount unavailable at /firmware"
    # The recovery ueventd configuration and vendor firmware symlinks use
    # /vendor/firmware_mnt/image, while TWRP's recovery.fstab names the same
    # modem partition /firmware. Mount it at both paths when the vendor
    # mountpoint exists so PIL/request_firmware can resolve stock symlinks.
    mount_partition /vendor/firmware_mnt modem && log "firmware/modem mounted at /vendor/firmware_mnt" || log "firmware_mnt mount unavailable"
    mount_partition /mnt/vendor/persist persist && log "persist mounted at /mnt/vendor/persist" || log "persist mount unavailable at /mnt/vendor/persist"
    mount_partition /persist persist >/dev/null 2>&1 || true

    stage_firmware

    # Use one coherent firmware root for the entire bring-up: WCNSS PIL files
    # copied from modem plus PRONTO cfg/NV/dictionary copied from stock vendor.
    if [ -w /sys/module/firmware_class/parameters/path ]; then
        echo /lib/firmware > /sys/module/firmware_class/parameters/path 2>/dev/null || true
        log "firmware_class.path=/lib/firmware"
    fi

    feed_pending_firmware

    # Unblock radio switches if recovery/kernel exposed rfkill.
    for state in /sys/class/rfkill/rfkill*/state; do
        [ -e "$state" ] || continue
        echo 1 > "$state" 2>/dev/null || true
    done

    # fwpath is a restart trigger in this built-in PRONTO driver. Once the
    # netdev exists, do not touch fwpath or reopen the one-shot WCNSS control
    # node; just make sure the existing interface is up.
    if [ -d "/sys/class/net/$IFACE" ]; then
        "$BB" ip link set "$IFACE" up 2>>"$PREPLOG" || true
        log "$IFACE already initialized; preserving running driver"
        return 0
    fi

    # /dev/wcnss_ctrl is intentionally one-shot in this kernel. If a previous
    # prepare attempt already completed the WCNSS trigger in this recovery boot,
    # reuse that state and retry only PRONTO instead of reopening the control
    # node (which would fail with -EFAULT).
    if [ -s "$STATE/wcnss.opened" ]; then
        log "WCNSS subsystem already triggered; reusing existing state"
    else
        # Minimal WCNSS userspace handshake. It intentionally avoids modem/QMI
        # and stores any runtime calibration only under /tmp. Wait for both
        # character devices instead of assuming ueventd created them already.
        i=0
        while [ "$i" -lt 10 ] && { [ ! -e /dev/wcnss_ctrl ] || [ ! -e /dev/wcnss_wlan ]; }; do
            "$BB" sleep 1
            i=$((i + 1))
        done

        if [ ! -e /dev/wcnss_ctrl ] || [ ! -e /dev/wcnss_wlan ]; then
            log "WCNSS control devices did not appear"
            return 1
        fi

        "$BB" rm -f "$STATE/wcnss.opened" 2>/dev/null || true
        if [ -x "$WCNSS" ]; then
            "$WCNSS" >> "$PREPLOG" 2>&1 &
            WCNSS_PID=$!
            log "wcnss recovery helper started pid=$WCNSS_PID"
        else
            log "missing WCNSS recovery helper"
            return 1
        fi

        # The helper creates this marker only after open(/dev/wcnss_wlan)
        # returns. In Channel that open synchronously performs subsystem_get()
        # and confirms the PIL trigger happened before PRONTO starts.
        i=0
        while [ "$i" -lt 15 ] && [ ! -s "$STATE/wcnss.opened" ]; do
            "$BB" sleep 1
            i=$((i + 1))
        done
        if [ ! -s "$STATE/wcnss.opened" ]; then
            log "WCNSS subsystem trigger did not complete"
            return 1
        fi
        log "WCNSS subsystem trigger completed"
        "$BB" sleep 1
    fi

    # Critical for this kernel: PRONTO_WLAN is built-in and hdd_module_init()
    # deliberately delays hdd_driver_init() until fwpath is changed by userspace.
    if [ -w /sys/module/wlan/parameters/fwpath ]; then
        echo sta > /sys/module/wlan/parameters/fwpath 2>>"$PREPLOG" || true
        log "requested PRONTO WLAN STA initialization through fwpath"
    fi

    # Wait for the netdev created by the delayed driver init.
    i=0
    while [ "$i" -lt 20 ]; do
        [ -d "/sys/class/net/$IFACE" ] && break
        "$BB" sleep 1
        i=$((i + 1))
    done

    if [ ! -d "/sys/class/net/$IFACE" ]; then
        log "$IFACE did not appear"
        return 1
    fi

    "$BB" ip link set "$IFACE" up 2>>"$PREPLOG" || true
    log "$IFACE is present"
    return 0
}

stop_supplicant() {
    pid=""
    [ -f "$STATE/wpa.pid" ] && pid="$(cat "$STATE/wpa.pid" 2>/dev/null)"

    # Ask only our own control socket to terminate. Do not use pkill -f here:
    # an adb shell command containing the wpa_supplicant path can otherwise
    # match and kill its parent shell.
    if [ -S "$CTRL/$IFACE" ]; then
        "$WPACLI" -p "$CTRL" -i "$IFACE" terminate >/dev/null 2>&1 || true
        "$BB" sleep 1
    fi

    case "$pid" in
        ''|*[!0-9]*) ;;
        *)
            if kill -0 "$pid" 2>/dev/null; then
                exe="$("$BB" readlink "/proc/$pid/exe" 2>/dev/null || true)"
                case "$exe" in
                    */wpa_supplicant.ds)
                        kill "$pid" 2>/dev/null || true
                        ;;
                esac
            fi
            ;;
    esac

    rm -f "$STATE/wpa.pid"
    "$BB" sleep 1
}

stop_udhcpd() {
    pid=""
    [ -f "$HOTSPOT_PID" ] && pid="$(cat "$HOTSPOT_PID" 2>/dev/null)"

    case "$pid" in
        ''|*[!0-9]*) ;;
        *)
            if kill -0 "$pid" 2>/dev/null; then
                exe="$("$BB" readlink "/proc/$pid/exe" 2>/dev/null || true)"
                case "$exe" in
                    */busybox.ds)
                        kill "$pid" 2>/dev/null || true
                        ;;
                esac
            fi
            ;;
    esac

    "$BB" rm -f "$HOTSPOT_PID" 2>/dev/null || true
}

clear_hotspot_state() {
    stop_udhcpd
    if [ -f "$HOTSPOT_MARKER" ]; then
        "$BB" ip addr flush dev "$IFACE" 2>/dev/null || true
        "$BB" rm -f "$HOTSPOT_MARKER" 2>/dev/null || true
    fi
}

write_base_conf() {
    target="$1"
    {
        printf '%s\n' 'ctrl_interface=/tmp/ds-wifi/ctrl'
        printf '%s\n' 'update_config=1'
        printf '%s\n' 'ap_scan=1'
    } > "$target" || return 1
    "$BB" chmod 600 "$target" 2>/dev/null || true
}

start_supplicant() {
    conf="$CONF"
    [ "$#" -ge 1 ] && conf="$1"

    if [ ! -f "$conf" ]; then
        [ "$conf" = "$CONF" ] || return 1
        write_base_conf "$CONF" || return 1
    fi

    clear_hotspot_state
    stop_supplicant
    "$BB" rm -rf "$CTRL"
    "$BB" mkdir -p "$CTRL"
    : > "$LOG"

    "$WPA" -B -P "$STATE/wpa.pid" -i "$IFACE" -D nl80211,wext \
        -c "$conf" -C "$CTRL" -f "$LOG" || {
        log "nl80211,wext startup failed; retrying wext only"
        "$WPA" -B -P "$STATE/wpa.pid" -i "$IFACE" -D wext \
            -c "$conf" -C "$CTRL" -f "$LOG"
    }
}

wait_connected() {
    limit="$1"
    [ -n "$limit" ] || limit=30
    i=0
    while [ "$i" -lt "$limit" ]; do
        state=$("$WPACLI" -p "$CTRL" -i "$IFACE" status 2>/dev/null | "$BB" sed -n 's/^wpa_state=//p')
        [ "$state" = "COMPLETED" ] && return 0
        "$BB" sleep 1
        i=$((i + 1))
    done
    return 1
}

do_dhcp() {
    "$BB" udhcpc -i "$IFACE" -s "$UDHCPC_SCRIPT" -p "$STATE/udhcpc.pid" \
        -t 8 -T 3 -A 1 -q
}

make_psk_conf() {
    ssid="$1"
    pass="$2"
    target="$3"
    {
        printf '%s\n' 'ctrl_interface=/tmp/ds-wifi/ctrl'
        printf '%s\n' 'update_config=1'
        printf '%s\n' 'ap_scan=1'
        "$WPAPASS" "$ssid" "$pass" | "$BB" sed '/^[[:space:]]*#psk=/d'
    } > "$target"
    "$BB" chmod 600 "$target" 2>/dev/null || true
    "$BB" grep -q '^[[:space:]]*network[[:space:]]*={' "$target" 2>/dev/null || {
        "$BB" rm -f "$target"
        return 1
    }
}

escape_wpa_string() {
    printf '%s' "$1" | "$BB" sed 's/\\/\\\\/g; s/"/\\"/g'
}

make_open_conf() {
    ssid=$(escape_wpa_string "$1")
    target="$2"
    {
        printf '%s\n' 'ctrl_interface=/tmp/ds-wifi/ctrl'
        printf '%s\n' 'update_config=1'
        printf '%s\n' 'ap_scan=1'
        printf '%s\n' 'network={'
        printf '    ssid="%s"\n' "$ssid"
        printf '%s\n' '    key_mgmt=NONE'
        printf '%s\n' '}'
    } > "$target"
    "$BB" chmod 600 "$target" 2>/dev/null || true
}

make_sae_conf() {
    ssid=$(escape_wpa_string "$1")
    pass=$(escape_wpa_string "$2")
    target="$3"
    {
        printf '%s\n' 'ctrl_interface=/tmp/ds-wifi/ctrl'
        printf '%s\n' 'update_config=1'
        printf '%s\n' 'ap_scan=1'
        printf '%s\n' 'network={'
        printf '    ssid="%s"\n' "$ssid"
        printf '%s\n' '    key_mgmt=SAE'
        printf '    sae_password="%s"\n' "$pass"
        printf '%s\n' '    ieee80211w=2'
        printf '%s\n' '}'
    } > "$target"
    "$BB" chmod 600 "$target" 2>/dev/null || true
}

append_network_block() {
    anb_source="$1"
    anb_target="$2"
    "$BB" sed -n '/^[[:space:]]*network[[:space:]]*={/,/^[[:space:]]*}[[:space:]]*$/p' "$anb_source" >> "$anb_target"
}

persist_network() {
    security="$1"
    ssid="$2"
    source="$3"

    ensure_persistent_store || return 1
    nid=$(network_id "$ssid") || return 1
    target="$PERSIST_NETWORKS/$nid.conf"
    tmp="$PERSIST_NETWORKS/.$nid.$$"

    {
        printf '%s\n' '# dswifi-db=1'
        printf '# security=%s\n' "$security"
    } > "$tmp" || return 1

    append_network_block "$source" "$tmp"
    "$BB" grep -q '^[[:space:]]*network[[:space:]]*={' "$tmp" 2>/dev/null || {
        "$BB" rm -f "$tmp"
        return 1
    }

    "$BB" chmod 600 "$tmp" 2>/dev/null || { "$BB" rm -f "$tmp"; return 1; }
    "$BB" chown 0:0 "$tmp" 2>/dev/null || { "$BB" rm -f "$tmp"; return 1; }
    "$BB" mv -f "$tmp" "$target" || { "$BB" rm -f "$tmp"; return 1; }
    "$BB" sync
    return 0
}

build_runtime_from_persistent() {
    PERSIST_COUNT=0
    ensure_persistent_store || return 1

    tmp="$STATE/.known-networks.$$"
    write_base_conf "$tmp" || return 1

    for saved in "$PERSIST_NETWORKS"/*.conf; do
        [ -f "$saved" ] || continue
        "$BB" grep -q '^[[:space:]]*network[[:space:]]*={' "$saved" 2>/dev/null || continue
        append_network_block "$saved" "$tmp"
        PERSIST_COUNT=$((PERSIST_COUNT + 1))
    done

    if [ "$PERSIST_COUNT" -eq 0 ]; then
        "$BB" rm -f "$tmp"
        return 1
    fi

    "$BB" chmod 600 "$tmp" 2>/dev/null || true
    "$BB" mv -f "$tmp" "$CONF" || { "$BB" rm -f "$tmp"; return 1; }
    return 0
}

copy_candidate_to_runtime() {
    source="$1"
    tmp="$STATE/.runtime.$$"
    "$BB" cp "$source" "$tmp" || return 1
    "$BB" chmod 600 "$tmp" 2>/dev/null || true
    "$BB" mv -f "$tmp" "$CONF" || { "$BB" rm -f "$tmp"; return 1; }
}

restore_known_after_failure() {
    "$BB" rm -f "$CANDIDATE" 2>/dev/null || true

    if ! "$BB" grep -q '^[[:space:]]*network[[:space:]]*={' "$CONF" 2>/dev/null; then
        build_runtime_from_persistent >/dev/null 2>&1 || return 0
    fi

    if "$BB" grep -q '^[[:space:]]*network[[:space:]]*={' "$CONF" 2>/dev/null; then
        start_supplicant "$CONF" >/dev/null 2>&1 || return 0
        if wait_connected 12; then
            do_dhcp >/dev/null 2>&1 || true
        fi
    fi
}

commit_validated_network() {
    security="$1"
    ssid="$2"
    source="$3"

    copy_candidate_to_runtime "$source" || return 1

    if persist_network "$security" "$ssid" "$source"; then
